{% for group in robots.default_groups -%}
{{ group.user_agent | strip }}
{% for rule in group.rules -%}
{{ rule | strip }}
{% endfor -%}
{%- if group.user_agent.value == '*' -%}
{%- comment -%}
  '/collections/all$' / 'all?*' / 'all/*' target only Shopify's auto-generated
  /collections/all catalogue page. Do NOT use 'all*' — it also blocks
  /collections/all-games, the store's main catalogue collection.
{%- endcomment -%}
Disallow: /collections/all$
Disallow: /collections/all?*
Disallow: /collections/all/*
Disallow: /collections/vendors*?*q=*
Disallow: /collections/types*?*q=*
Disallow: /collections/*?*constraint*
Disallow: /collections/*/*
Disallow: /collections/*?*filter*
Disallow: /collections/*?*pf_*
Disallow: /collections/*?*view*
Disallow: /collections/*?*grid_list*
Disallow: /collections/?page=*
Disallow: /blogs/*/tagged/*
{% endif -%}
{% if group.sitemap != blank -%}
{{ group.sitemap | strip }}
{% endif -%}
{% endfor %}
