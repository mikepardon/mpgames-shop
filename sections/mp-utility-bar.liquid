{%- comment -%}
  MPGames utility bar — top dark strip above the main header.
{%- endcomment -%}

{%- style -%}
  .mp-ub-{{ section.id }} {
    background: #0d1c27;
    font-family: 'Barlow', ui-sans-serif, system-ui, sans-serif;
  }
  .mp-ub-{{ section.id }} .mp-ub__in {
    width: 100%;
    font-size: 12px;
    padding: 7px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .mp-ub-{{ section.id }} .mp-ub__usps {
    display: flex;
    gap: 28px;
    align-items: center;
  }
  .mp-ub-{{ section.id }} .mp-ub__usp {
    color: #fff;
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
  }
  .mp-ub-{{ section.id }} .mp-ub__reviews {
    display: flex;
    align-items: center;
    gap: 7px;
    white-space: nowrap;
  }
  .mp-ub-{{ section.id }} .mp-ub__stars { color: #f4b942; letter-spacing: 1px; }
  .mp-ub-{{ section.id }} .mp-ub__review-link { color: #cfd8dc; text-decoration: none; }
  .mp-ub-{{ section.id }} .mp-ub__review-link:hover { color: #fff; }
  @media (max-width: 749px) {
    .mp-ub-{{ section.id }} .mp-ub__in { font-size: 11px; padding: 6px 16px; }
    .mp-ub-{{ section.id }} .mp-ub__usp:not(:first-child) { display: none; }
    .mp-ub-{{ section.id }} .mp-ub__reviews { display: none; }
  }
{%- endstyle -%}

<div class="mp-ub-{{ section.id }}">
  <div class="mp-ub__in">
    <div class="mp-ub__usps">
      {%- if section.settings.usp_1_label != blank -%}
        {%- if section.settings.usp_1_url != blank -%}
          <a href="{{ section.settings.usp_1_url }}" class="mp-ub__usp">{{ section.settings.usp_1_label }}</a>
        {%- else -%}
          <span class="mp-ub__usp">{{ section.settings.usp_1_label }}</span>
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.usp_2_label != blank -%}
        {%- if section.settings.usp_2_url != blank -%}
          <a href="{{ section.settings.usp_2_url }}" class="mp-ub__usp">{{ section.settings.usp_2_label }}</a>
        {%- else -%}
          <span class="mp-ub__usp">{{ section.settings.usp_2_label }}</span>
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.usp_3_label != blank -%}
        {%- if section.settings.usp_3_url != blank -%}
          <a href="{{ section.settings.usp_3_url }}" class="mp-ub__usp">{{ section.settings.usp_3_label }}</a>
        {%- else -%}
          <span class="mp-ub__usp">{{ section.settings.usp_3_label }}</span>
        {%- endif -%}
      {%- endif -%}
    </div>
    {%- if section.settings.review_label != blank -%}
      <div class="mp-ub__reviews">
        <span class="mp-ub__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        {%- if section.settings.review_url != blank -%}
          <a href="{{ section.settings.review_url }}" class="mp-ub__review-link">{{ section.settings.review_label }}</a>
        {%- else -%}
          <span class="mp-ub__review-link">{{ section.settings.review_label }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "MP Utility bar",
  "settings": [
    { "type": "header", "content": "USPs" },
    { "type": "text", "id": "usp_1_label", "label": "USP 1", "default": "Free UK delivery over £50" },
    { "type": "url", "id": "usp_1_url", "label": "USP 1 link (optional)" },
    { "type": "text", "id": "usp_2_label", "label": "USP 2", "default": "Next working day dispatch" },
    { "type": "url", "id": "usp_2_url", "label": "USP 2 link (optional)" },
    { "type": "text", "id": "usp_3_label", "label": "USP 3", "default": "Price-match promise" },
    { "type": "url", "id": "usp_3_url", "label": "USP 3 link (optional)" },
    { "type": "header", "content": "Reviews" },
    { "type": "text", "id": "review_label", "label": "Review text", "default": "4.93 from 44 customer reviews" },
    { "type": "url", "id": "review_url", "label": "Review link (optional)" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
