{%- comment -%}
  MPGames collection page — 2-col hero, horizontal filter bar, full-width grid, SEO copy at bottom.
{%- endcomment -%}

{%- style -%}
  .mp-cl-{{ section.id }} { background: #FBF7F0; font-family: 'Barlow', ui-sans-serif, system-ui, sans-serif; color: #14233A; overflow-x: clip; }
  .mp-cl-{{ section.id }} .cl__wrap { max-width: 1280px; margin: 0 auto; padding: 0 24px 60px; }

  /* Breadcrumb */
  .mp-cl-{{ section.id }} .cl__crumb { padding: 16px 0 0; font-size: 13px; color: #4F5D70; display: flex; gap: 8px; flex-wrap: wrap; }
  .mp-cl-{{ section.id }} .cl__crumb a { color: #4F5D70; text-decoration: none; }
  .mp-cl-{{ section.id }} .cl__crumb a:hover { color: #B4530F; }

  /* Hero */
  .mp-cl-{{ section.id }} .cl__hero { margin-top: 16px; display: grid; grid-template-columns: minmax(0,1.3fr) minmax(0,1fr); gap: 24px; align-items: center; border-radius: 24px; padding: 40px 44px; min-height: 280px; box-sizing: border-box; overflow: hidden; position: relative; }
  .mp-cl-{{ section.id }} .cl__hero-left { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 12px; }
  .mp-cl-{{ section.id }} .cl__kicker { font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,.7); margin: 0; }
  .mp-cl-{{ section.id }} .cl__htitle { margin: 0; font-size: clamp(44px,5.5vw,76px); font-weight: 800; color: #fff; line-height: .95; text-transform: uppercase; }
  .mp-cl-{{ section.id }} .cl__hsub { margin: 0; font-size: 17px; line-height: 1.45; color: rgba(255,255,255,.85); max-width: 460px; }
  .mp-cl-{{ section.id }} .cl__hlink { color: #fff; font-size: 14px; font-weight: 600; text-decoration: underline; align-self: flex-start; padding: 4px 0; }
  .mp-cl-{{ section.id }} .cl__hero-art { position: relative; height: 220px; overflow: visible; }
  .mp-cl-{{ section.id }} .cl__hero-circle { position: absolute; left: 0; top: -60px; width: 100%; aspect-ratio: 1; border-radius: 999px; background: repeating-conic-gradient(from 0deg at 50% 50%,rgba(255,255,255,.10) 0deg 7deg,rgba(255,255,255,0) 7deg 20deg); pointer-events: none; }
  .mp-cl-{{ section.id }} .cl__hero-glow { position: absolute; left: 25%; top: 5%; width: 50%; aspect-ratio: 1; border-radius: 999px; background: rgba(255,255,255,.12); pointer-events: none; }
  .mp-cl-{{ section.id }} .cl__hero-img { position: absolute; right: 4%; top: 0; width: 58%; height: auto; transform: rotate(5deg); filter: drop-shadow(0 14px 18px rgba(0,0,0,.35)); object-fit: contain; }

  /* Chips */
  .mp-cl-{{ section.id }} .cl__chips { display: flex; gap: 8px; padding: 16px 0 0; overflow-x: auto; scrollbar-width: none; flex-wrap: wrap; }
  .mp-cl-{{ section.id }} .cl__chips::-webkit-scrollbar { display: none; }
  .mp-cl-{{ section.id }} .cl__chip { display: flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 14px 0 10px; border-radius: 999px; border: 1.5px solid #D9CFBE; background: #fff; color: #14233A; font-size: 14px; font-weight: 600; text-decoration: none; white-space: nowrap; transition: border-color .15s, background .15s; }
  .mp-cl-{{ section.id }} .cl__chip:hover { border-color: #14233A; }
  .mp-cl-{{ section.id }} .cl__chip.is-active { background: #14233A; border-color: #14233A; color: #fff; }
  .mp-cl-{{ section.id }} .cl__chip-dot { width: 12px; height: 12px; border-radius: 999px; background: #B4530F; flex: none; }
  .mp-cl-{{ section.id }} .cl__chip.is-active .cl__chip-dot { background: rgba(255,255,255,.7); }

  /* Active filter chips */
  .mp-cl-{{ section.id }} .cl__factive { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 20px; }
  .mp-cl-{{ section.id }} .cl__factive-label { font-size: 12px; font-weight: 700; color: #4F5D70; text-transform: uppercase; letter-spacing: .06em; }
  .mp-cl-{{ section.id }} .cl__fachip { display: inline-flex; align-items: center; gap: 6px; background: #EEE8DE; border: 1px solid #D9CFBE; border-radius: 8px; padding: 5px 10px; font-size: 13px; font-weight: 600; color: #14233A; text-decoration: none; }
  .mp-cl-{{ section.id }} .cl__fachip:hover { background: #E2D9CC; }
  .mp-cl-{{ section.id }} .cl__factive-clear { font-size: 13px; font-weight: 600; color: #B4530F; text-decoration: underline; margin-left: 4px; }

  /* Filter bar */
  .mp-cl-{{ section.id }} .cl__filterbar { margin-top: 12px; background: #fff; border: 1px solid #ECE3D3; border-radius: 16px; padding: 16px 20px; display: flex; flex-wrap: wrap; gap: 14px 24px; align-items: center; }

  /* Inline pill group (≤ 8 values) */
  .mp-cl-{{ section.id }} .cl__fgroup { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .mp-cl-{{ section.id }} .cl__fgroup-label { font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #4F5D70; margin-right: 2px; white-space: nowrap; }
  .mp-cl-{{ section.id }} .cl__fpills { display: flex; flex-wrap: wrap; gap: 6px; }
  .mp-cl-{{ section.id }} .cl__fpill { min-height: 38px; min-width: 44px; padding: 0 12px; border-radius: 10px; border: 1.5px solid #D9CFBE; background: #fff; color: #14233A; font-size: 14px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; white-space: nowrap; transition: background .15s, border-color .15s, color .15s; }
  .mp-cl-{{ section.id }} .cl__fpill:hover { border-color: #14233A; }
  .mp-cl-{{ section.id }} .cl__fpill.is-on { background: #14233A; border-color: #14233A; color: #fff; }

  /* Dropdown filter */
  .mp-cl-{{ section.id }} .cl__fdrop { position: relative; }
  .mp-cl-{{ section.id }} .cl__fdrop-btn { list-style: none; min-height: 40px; padding: 0 14px; border-radius: 10px; border: 1.5px solid #D9CFBE; background: #fff; color: #14233A; font-family: inherit; font-size: 14px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; user-select: none; }
  .mp-cl-{{ section.id }} .cl__fdrop-btn::-webkit-details-marker { display: none; }
  .mp-cl-{{ section.id }} details.cl__fdrop[open] .cl__fdrop-btn { border-color: #14233A; background: #14233A; color: #fff; }
  .mp-cl-{{ section.id }} .cl__fdrop-panel { position: absolute; top: calc(100% + 6px); left: 0; z-index: 40; background: #fff; border: 1px solid #ECE3D3; border-radius: 12px; box-shadow: 0 8px 24px rgba(20,35,58,.12); min-width: 220px; max-height: 300px; overflow-y: auto; padding: 8px 0; }
  .mp-cl-{{ section.id }} .cl__fdrop-opt { display: flex; align-items: center; gap: 10px; padding: 10px 16px; font-size: 14px; color: #14233A; text-decoration: none; transition: background .1s; }
  .mp-cl-{{ section.id }} .cl__fdrop-opt:hover { background: #F5EFE5; }
  .mp-cl-{{ section.id }} .cl__fdrop-opt.is-on { font-weight: 700; }
  .mp-cl-{{ section.id }} .cl__fcheck { width: 18px; height: 18px; border: 1.5px solid #B6AFA4; border-radius: 4px; display: inline-flex; align-items: center; justify-content: center; font-size: 11px; flex: none; color: #fff; }
  .mp-cl-{{ section.id }} .cl__fdrop-opt.is-on .cl__fcheck { background: #14233A; border-color: #14233A; }
  .mp-cl-{{ section.id }} .cl__fcnt { color: #9B948A; margin-left: auto; font-size: 12px; }

  /* Price form inside dropdown */
  .mp-cl-{{ section.id }} .cl__fprice { display: flex; flex-direction: column; gap: 8px; padding: 12px 16px; }
  .mp-cl-{{ section.id }} .cl__fprice input { border: 1px solid #D9CFBE; border-radius: 8px; padding: 8px 12px; font: inherit; font-size: 14px; color: #14233A; width: 100%; box-sizing: border-box; }
  .mp-cl-{{ section.id }} .cl__fprice button { background: #14233A; color: #fff; border: 0; border-radius: 8px; padding: 10px; font: 700 14px/1 inherit; cursor: pointer; text-transform: uppercase; letter-spacing: .05em; }

  /* Sort */
  .mp-cl-{{ section.id }} .cl__fsort { margin-left: auto; display: flex; align-items: center; gap: 10px; }
  .mp-cl-{{ section.id }} .cl__sort-label { font-size: 14px; color: #4F5D70; white-space: nowrap; }
  .mp-cl-{{ section.id }} .cl__sort-sel { min-height: 40px; padding: 0 12px; border-radius: 10px; border: 1.5px solid #D9CFBE; background: #fff; font: inherit; font-size: 14px; color: #14233A; cursor: pointer; }

  /* Count + grid */
  .mp-cl-{{ section.id }} .cl__count { margin: 18px 0 16px; font-size: 14px; color: #4F5D70; }
  .mp-cl-{{ section.id }} .cl__count b { color: #14233A; }
  .mp-cl-{{ section.id }} .cl__grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(200px,1fr)); gap: 16px; }

  /* Cards */
  .mp-cl-{{ section.id }} .cl__card { background: #fff; border: 1px solid #ECE3D3; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; position: relative; }
  .mp-cl-{{ section.id }} .cl__flag { position: absolute; top: 12px; left: 12px; z-index: 2; font-size: 11px; font-weight: 800; letter-spacing: .8px; text-transform: uppercase; padding: 5px 9px; border-radius: 6px; }
  .mp-cl-{{ section.id }} .cl__flag--pre { background: #FDE9D4; color: #B4530F; }
  .mp-cl-{{ section.id }} .cl__flag--sale { background: #FFE4E1; color: #C0392B; }
  .mp-cl-{{ section.id }} .cl__media-wrap { aspect-ratio: 1/1; max-height: 240px; background: #F3EDE2; display: flex; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box; text-decoration: none; }
  .mp-cl-{{ section.id }} .cl__media-wrap img { max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 4px; box-shadow: 0 10px 22px rgba(20,35,58,.18); }
  .mp-cl-{{ section.id }} .cl__cbody { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .mp-cl-{{ section.id }} .cl__eyebrow { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 20px; }
  .mp-cl-{{ section.id }} .cl__eyebrow-type { font-size: 12px; font-weight: 700; letter-spacing: .6px; text-transform: uppercase; }
  .mp-cl-{{ section.id }} .cl__bgg { display: inline-flex; align-items: center; gap: 4px; background: #14233A; color: #fff; border-radius: 6px; padding: 3px 7px; font-size: 12px; font-weight: 700; white-space: nowrap; }
  .mp-cl-{{ section.id }} .cl__bgg-score { color: #F5B841; }
  .mp-cl-{{ section.id }} .cl__name { font-size: 16px; font-weight: 700; line-height: 1.25; color: #14233A; text-decoration: none; }
  .mp-cl-{{ section.id }} .cl__name:hover { color: #B4530F; }
  .mp-cl-{{ section.id }} .cl__pub { font-size: 13px; color: #4F5D70; }
  .mp-cl-{{ section.id }} .cl__metarow { display: flex; gap: 12px; font-size: 12px; color: #6A7686; flex-wrap: wrap; }
  .mp-cl-{{ section.id }} .cl__status { display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; }
  .mp-cl-{{ section.id }} .cl__status-dot { width: 8px; height: 8px; border-radius: 999px; flex: none; display: inline-block; }
  .mp-cl-{{ section.id }} .cl__foot { margin-top: auto; padding-top: 12px; display: flex; align-items: flex-end; justify-content: space-between; gap: 8px; }
  .mp-cl-{{ section.id }} .cl__price-wrap { display: flex; flex-direction: column; gap: 2px; }
  .mp-cl-{{ section.id }} .cl__rrp { font-size: 12px; color: #6A7686; text-decoration: line-through; }
  .mp-cl-{{ section.id }} .cl__pr { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 26px; line-height: 1; color: #14233A; }
  .mp-cl-{{ section.id }} .cl__add { min-height: 44px; padding: 0 16px; border-radius: 10px; border: 0; background: #14233A; color: #fff; font: 700 14px/1 inherit; cursor: pointer; white-space: nowrap; transition: background .15s; }
  .mp-cl-{{ section.id }} .cl__add:hover { background: #1E3555; }
  .mp-cl-{{ section.id }} .cl__notify { min-height: 44px; padding: 0 16px; border-radius: 10px; border: 1.5px solid #14233A; color: #14233A; font-size: 14px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; white-space: nowrap; }
  .mp-cl-{{ section.id }} .cl__card form { margin: 0; }

  /* Empty state */
  .mp-cl-{{ section.id }} .cl__empty { background: #fff; border: 1.5px dashed #D9CFBE; border-radius: 16px; padding: 48px 24px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .mp-cl-{{ section.id }} .cl__empty h2 { margin: 0; font-size: 28px; font-weight: 800; text-transform: uppercase; }
  .mp-cl-{{ section.id }} .cl__empty p { margin: 0; color: #4F5D70; font-size: 15px; }
  .mp-cl-{{ section.id }} .cl__empty a { min-height: 44px; padding: 0 18px; border-radius: 10px; background: #14233A; color: #fff; font: 700 14px/44px inherit; text-decoration: none; display: inline-block; }

  /* Pagination */
  .mp-cl-{{ section.id }} .cl__pager { display: flex; justify-content: space-between; align-items: center; margin-top: 32px; flex-wrap: wrap; gap: 12px; }
  .mp-cl-{{ section.id }} .cl__pager-info { font-size: 13px; color: #8A8278; }
  .mp-cl-{{ section.id }} .cl__pages { display: flex; align-items: center; gap: 8px; font-size: 13px; flex-wrap: wrap; }
  .mp-cl-{{ section.id }} .cl__pages a, .mp-cl-{{ section.id }} .cl__pages span { border: 1px solid #D9CFBE; border-radius: 8px; padding: 8px 13px; color: #6A7686; text-decoration: none; }
  .mp-cl-{{ section.id }} .cl__pages .is-current { border-color: #14233A; background: #14233A; color: #fff; }
  .mp-cl-{{ section.id }} .cl__pages .is-disabled { color: #CCC4B8; }

  /* Game finder nudge */
  .mp-cl-{{ section.id }} .cl__nudge { margin-top: 48px; background: #14233A; color: #fff; border-radius: 20px; padding: 28px 32px; display: flex; flex-wrap: wrap; gap: 16px 32px; align-items: center; justify-content: space-between; }
  .mp-cl-{{ section.id }} .cl__nudge-text { display: flex; flex-direction: column; gap: 6px; }
  .mp-cl-{{ section.id }} .cl__nudge-title { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 30px; line-height: 1; text-transform: uppercase; }
  .mp-cl-{{ section.id }} .cl__nudge-sub { color: #C9D3E0; font-size: 15px; }
  .mp-cl-{{ section.id }} .cl__nudge-cta { min-height: 48px; padding: 0 22px; border-radius: 12px; background: #F59A3A; color: #14233A; font: 800 15px/1 'Barlow Condensed', sans-serif; text-decoration: none; display: inline-flex; align-items: center; text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; transition: background .15s; }
  .mp-cl-{{ section.id }} .cl__nudge-cta:hover { background: #E8862A; }

  /* SEO section */
  .mp-cl-{{ section.id }} .cl__about { margin-top: 48px; padding-top: 48px; border-top: 1px solid #ECE3D3; max-width: 720px; }
  .mp-cl-{{ section.id }} .cl__about-heading { margin: 0 0 20px; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 32px; line-height: 1; text-transform: uppercase; color: #14233A; }
  .mp-cl-{{ section.id }} .cl__about-body { font-size: 15px; line-height: 1.65; color: #34445A; }
  .mp-cl-{{ section.id }} .cl__about-body p { margin: 0 0 12px; }
  .mp-cl-{{ section.id }} .cl__about-body > :last-child { margin-bottom: 0; }
  .mp-cl-{{ section.id }} .cl__about-body h2, .mp-cl-{{ section.id }} .cl__about-body h3 { font-size: 17px; font-weight: 700; margin: 18px 0 8px; color: #14233A; }
  .mp-cl-{{ section.id }} .cl__about-body ul { margin: 0 0 12px; padding-left: 20px; }
  .mp-cl-{{ section.id }} .cl__about-body li { margin: 0 0 5px; }
  .mp-cl-{{ section.id }} .cl__about-body a { color: #B4530F; }

  /* Responsive */
  @media (max-width: 860px) {
    .mp-cl-{{ section.id }} .cl__hero { grid-template-columns: 1fr; padding: 32px 28px; }
    .mp-cl-{{ section.id }} .cl__hero-art { display: none; }
  }
  @media (max-width: 749px) {
    .mp-cl-{{ section.id }} .cl__wrap { padding: 0 16px 48px; }
    .mp-cl-{{ section.id }} .cl__htitle { font-size: 42px; }
    .mp-cl-{{ section.id }} .cl__filterbar { padding: 14px 16px; gap: 10px 16px; }
    .mp-cl-{{ section.id }} .cl__nudge { padding: 24px 20px; }
    .mp-cl-{{ section.id }} .cl__about { margin-top: 36px; padding-top: 36px; }
  }
{%- endstyle -%}

{%- liquid
  case collection.handle
    when 'category-party'
      assign default_hero_bg = '#C2410C'
      assign default_hero_subtitle = 'Big groups, loud tables, rules explained in five minutes.'
      assign default_hero_asset = 'party-games-tile-art2x.png'
    when 'category-family'
      assign default_hero_bg = '#F5B841'
      assign default_hero_subtitle = 'Easy to teach, hard to put down. Great from age 8.'
      assign default_hero_asset = 'family-games-tile-art2x.png'
    when 'category-strategy'
      assign default_hero_bg = '#1F4E5A'
      assign default_hero_subtitle = 'Long-haul thinkers for nights that run late.'
      assign default_hero_asset = 'strategy-tile-art2x.png'
    when 'players-2'
      assign default_hero_bg = '#2E4A8C'
      assign default_hero_subtitle = 'Head-to-head duels for you and one other.'
      assign default_hero_asset = 'two-player-tile-art2x.png'
    when 'players-coop'
      assign default_hero_bg = '#2F6B47'
      assign default_hero_subtitle = 'Win together, or lose together. Everyone is on the same side.'
      assign default_hero_asset = 'co-op-tile-art2x.png'
    when 'category-card'
      assign default_hero_bg = '#5B3F8C'
      assign default_hero_subtitle = 'Pocket-sized, big on play.'
      assign default_hero_asset = 'card-games-tile-art2x.png'
    when 'expansions'
      assign default_hero_bg = '#4A3820'
      assign default_hero_subtitle = 'More of the games you already love.'
      assign default_hero_asset = 'expansions-tile-art2x.png'
    when 'pre-owned'
      assign default_hero_bg = '#1B1E26'
      assign default_hero_subtitle = 'Checked, counted and cheaper. Every copy photographed before it ships.'
    when 'players-solo'
      assign default_hero_bg = '#3D2B5C'
      assign default_hero_subtitle = 'Games built to challenge one player — no compromises.'
    when 'best-sellers'
      assign default_hero_bg = '#14233A'
      assign default_hero_subtitle = 'The games your customers keep coming back to buy.'
    when 'new-releases'
      assign default_hero_bg = '#14233A'
      assign default_hero_subtitle = 'Fresh stock, straight off the pallet.'
    when 'pre-orders'
      assign default_hero_bg = '#1C3A4A'
      assign default_hero_subtitle = 'Lock in your copy before it lands. We ship the day stock arrives.'
    when 'top-rated'
      assign default_hero_bg = '#2B1F40'
      assign default_hero_subtitle = 'Ranked by BoardGameGeek score — the highest-rated games on the planet.'
    else
      assign default_hero_bg = '#14233A'
  endcase
  assign hero_bg = collection.metafields.custom.hero_bg.value | default: section.settings.hero_bg | default: default_hero_bg
  assign hero_subtitle = collection.metafields.custom.hero_subtitle.value | default: default_hero_subtitle
  assign hero_link_label = collection.metafields.custom.hero_link_label.value | default: section.settings.hero_link_label
  assign hero_link_url = collection.metafields.custom.hero_link_url.value | default: section.settings.hero_link_url
  if section.settings.hero_image != blank
    assign hero_art_image = section.settings.hero_image
  elsif collection.image != blank
    assign hero_art_image = collection.image
  endif
-%}

<section class="mp-cl-{{ section.id }}">
  <div class="cl__wrap">

    <nav class="cl__crumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">›</span>
      <span aria-current="page" style="color:#14233A;font-weight:600">{{ collection.title }}</span>
    </nav>

    <section class="cl__hero" style="background: {{ hero_bg }}">
      <div class="cl__hero-left">
        <span class="cl__kicker mp-cond">
          {%- if section.settings.hero_kicker != blank -%}{{ section.settings.hero_kicker }} · {%- endif -%}{{ collection.products_count }} games
        </span>
        <h1 class="cl__htitle mp-cond">{{ collection.title }}</h1>
        {%- if hero_subtitle != blank -%}
          <p class="cl__hsub">{{ hero_subtitle }}</p>
        {%- endif -%}
        {%- if hero_link_label != blank and hero_link_url != blank -%}
          <a class="cl__hlink" href="{{ hero_link_url }}">{{ hero_link_label }}</a>
        {%- endif -%}
      </div>
      <div class="cl__hero-art" aria-hidden="true">
        <span class="cl__hero-circle"></span>
        <span class="cl__hero-glow"></span>
        {%- if hero_art_image != blank -%}
          {{ hero_art_image | image_url: width: 600 | image_tag: alt: '', class: 'cl__hero-img', loading: 'eager', width: 600, height: 600 }}
        {%- elsif default_hero_asset != blank -%}
          <img class="cl__hero-img" src="{{ default_hero_asset | asset_url }}" alt="" loading="eager" width="600" height="600">
        {%- endif -%}
      </div>
    </section>

    {%- if section.settings.chips_menu != blank and linklists[section.settings.chips_menu].links.size > 0 -%}
      <nav class="cl__chips" aria-label="Other categories">
        {%- for link in linklists[section.settings.chips_menu].links -%}
          <a class="cl__chip mp-cond{% if link.active or link.url == collection.url %} is-active{% endif %}" href="{{ link.url }}">
            <span class="cl__chip-dot" aria-hidden="true"></span>{{ link.title }}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- liquid
        assign start = paginate.current_offset | plus: 1
        assign finish = paginate.current_offset | plus: collection.products.size
        assign any_active = false
        for f in collection.filters
          if f.active_values.size > 0
            assign any_active = true
          endif
          if f.type == 'price_range'
            if f.min_value.value or f.max_value.value
              assign any_active = true
            endif
          endif
        endfor
      -%}

      {%- if any_active -%}
        <div class="cl__factive" aria-label="Active filters">
          <span class="cl__factive-label mp-cond">Filters:</span>
          {%- for f in collection.filters -%}
            {%- for v in f.active_values -%}
              <a class="cl__fachip" href="{{ v.url_to_remove }}">{{ v.label }} &times;</a>
            {%- endfor -%}
            {%- if f.type == 'price_range' -%}
              {%- if f.min_value.value or f.max_value.value -%}
                <a class="cl__fachip" href="{{ f.url_to_remove }}">
                  {%- if f.min_value.value and f.max_value.value -%}{{ f.min_value.value | money }}–{{ f.max_value.value | money }}{%- elsif f.min_value.value -%}From {{ f.min_value.value | money }}{%- else -%}Up to {{ f.max_value.value | money }}{%- endif -%}
                  &times;
                </a>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <a class="cl__factive-clear" href="{{ collection.url }}">Clear all</a>
        </div>
      {%- endif -%}

      <section class="cl__filterbar" aria-label="Filter and sort">
        {%- for f in collection.filters -%}
          {%- if f.type == 'price_range' -%}
            <details class="cl__fdrop">
              <summary class="cl__fdrop-btn mp-cond">{{ f.label }} &#9660;</summary>
              <div class="cl__fdrop-panel">
                <form method="get" class="cl__fprice">
                  {%- for af in collection.filters -%}
                    {%- unless af.type == 'price_range' -%}
                      {%- for v in af.active_values -%}
                        <input type="hidden" name="{{ v.param_name }}" value="{{ v.value }}">
                      {%- endfor -%}
                    {%- endunless -%}
                  {%- endfor -%}
                  {%- if collection.sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{%- endif -%}
                  <input type="number" name="{{ f.min_value.param_name }}" placeholder="{{ f.range_min | money_without_currency | default: 'Min' }}" value="{{ f.min_value.value }}" min="0">
                  <input type="number" name="{{ f.max_value.param_name }}" placeholder="{{ f.range_max | money_without_currency | default: 'Max' }}" value="{{ f.max_value.value }}" min="0">
                  <button type="submit" class="mp-cond">Apply price</button>
                </form>
              </div>
            </details>
          {%- elsif f.values.size <= 8 -%}
            <div class="cl__fgroup" role="group" aria-label="{{ f.label | escape }}">
              <span class="cl__fgroup-label mp-cond">{{ f.label }}</span>
              <div class="cl__fpills">
                {%- for v in f.values -%}
                  <a class="cl__fpill mp-cond{% if v.active %} is-on{% endif %}" href="{% if v.active %}{{ v.url_to_remove }}{% else %}{{ v.url_to_add }}{% endif %}">{{ v.label }}</a>
                {%- endfor -%}
              </div>
            </div>
          {%- else -%}
            <details class="cl__fdrop">
              <summary class="cl__fdrop-btn mp-cond">{{ f.label }}{% if f.active_values.size > 0 %} ({{ f.active_values.size }}){% endif %} &#9660;</summary>
              <div class="cl__fdrop-panel">
                {%- for v in f.values -%}
                  <a class="cl__fdrop-opt{% if v.active %} is-on{% endif %}" href="{% if v.active %}{{ v.url_to_remove }}{% else %}{{ v.url_to_add }}{% endif %}">
                    <span class="cl__fcheck" aria-hidden="true">{% if v.active %}&#10003;{% endif %}</span>
                    <span>{{ v.label }}</span>
                    <span class="cl__fcnt">{{ v.count }}</span>
                  </a>
                {%- endfor -%}
              </div>
            </details>
          {%- endif -%}
        {%- endfor -%}

        <form method="get" class="cl__fsort">
          {%- for f in collection.filters -%}
            {%- for v in f.active_values -%}<input type="hidden" name="{{ v.param_name }}" value="{{ v.value }}">{%- endfor -%}
            {%- if f.type == 'price_range' -%}
              {%- if f.min_value.value -%}<input type="hidden" name="{{ f.min_value.param_name }}" value="{{ f.min_value.value }}">{%- endif -%}
              {%- if f.max_value.value -%}<input type="hidden" name="{{ f.max_value.param_name }}" value="{{ f.max_value.value }}">{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <label for="cl-sort-{{ section.id }}" class="cl__sort-label">Sort</label>
          <select id="cl-sort-{{ section.id }}" name="sort_by" onchange="this.form.submit()" class="cl__sort-sel" aria-label="Sort products">
            {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
            {%- for opt in collection.sort_options -%}
              <option value="{{ opt.value }}"{% if opt.value == current_sort %} selected{% endif %}>{{ opt.name }}</option>
            {%- endfor -%}
          </select>
        </form>
      </section>

      <p class="cl__count" aria-live="polite">Showing <b>{{ start }}–{{ finish }}</b> of <b>{{ collection.products_count }}</b> games</p>

      {%- if collection.products.size > 0 -%}
        <div class="cl__grid">
          {%- assign cl_passes = 'available,unavailable' | split: ',' -%}
          {%- for cl_pass in cl_passes -%}
            {%- for product in collection.products -%}
              {%- if cl_pass == 'available' and product.available == false -%}{%- continue -%}{%- endif -%}
              {%- if cl_pass == 'unavailable' and product.available -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign cb = product.metafields.custom.bgg_rating.value
                assign cbn = cb | times: 1.0
                assign cb_int = cbn | times: 10 | round
                assign cb_whole = cb_int | divided_by: 10 | floor
                assign cb_dec = cb_int | modulo: 10
                assign cb_display = cb_whole | append: '.' | append: cb_dec
                assign csale = false
                if product.compare_at_price > product.price
                  assign csale = true
                  assign cdisc = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
                endif
                assign cmrsp = product.metafields.custom.mrsp.value
                assign cshow_rrp = false
                if cmrsp != blank and csale == false
                  assign cmrsp_cents = cmrsp | times: 100 | round
                  if cmrsp_cents > product.price
                    assign cshow_rrp = true
                  endif
                endif
                assign players = product.metafields.custom.player_count.value
                assign playtime = product.metafields.custom.play_time.value
                assign age = product.metafields.custom.min_age.value
                assign cpre = product.metafields.custom.is_preorder.value
              -%}
              <article class="cl__card">
                {%- if cpre -%}<span class="cl__flag cl__flag--pre mp-cond">Pre-order</span>
                {%- elsif csale -%}<span class="cl__flag cl__flag--sale mp-cond">-{{ cdisc }}%</span>{%- endif -%}
                {% render 'mp-wishlist-button', product: product, class: 'mp-wish--float' %}
                <a class="cl__media-wrap" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                  {%- if product.featured_image -%}
                    {{ product.featured_image | image_url: width: 520 | image_tag: alt: product.title, loading: 'lazy', widths: '260, 520', width: 520, height: 520 }}
                  {%- endif -%}
                </a>
                <div class="cl__cbody">
                  <div class="cl__eyebrow">
                    {%- if product.type == 'Board Game Expansion' -%}
                      <span class="cl__eyebrow-type" style="color:#6A4F86">Expansion</span>
                    {%- elsif product.type != blank -%}
                      <span class="cl__eyebrow-type" style="color:#4F5D70">{{ product.type }}</span>
                    {%- else -%}
                      <span></span>
                    {%- endif -%}
                    {%- if cb != blank -%}
                      <span class="cl__bgg"><span class="mp-cond" style="font-size:11px;letter-spacing:.5px">BGG</span><span class="cl__bgg-score"> {{ cb_display }}</span></span>
                    {%- endif -%}
                  </div>
                  <a class="cl__name" href="{{ product.url }}">{{ product.title }}</a>
                  {%- if product.vendor != blank -%}<div class="cl__pub">{{ product.vendor }}</div>{%- endif -%}
                  {%- if players != blank or playtime != blank or age != blank -%}
                    <div class="cl__metarow">
                      {%- if players != blank -%}<span>&#9823; {{ players }}</span>{%- endif -%}
                      {%- if playtime != blank -%}<span>&#9201; {{ playtime }}</span>{%- endif -%}
                      {%- if age != blank -%}<span>&#9817; {{ age }}+</span>{%- endif -%}
                    </div>
                  {%- endif -%}
                  {%- if cpre -%}
                    <div class="cl__status" style="color:#B4530F"><span class="cl__status-dot" style="background:#F59A3A"></span>Pre-order{% if product.metafields.custom.preorder_eta.value != blank %} · ETA {{ product.metafields.custom.preorder_eta.value }}{% endif %}</div>
                  {%- elsif product.available -%}
                    <div class="cl__status" style="color:#1F7A4A"><span class="cl__status-dot" style="background:#1F7A4A"></span>In stock</div>
                  {%- else -%}
                    <div class="cl__status" style="color:#8A3B2E"><span class="cl__status-dot" style="background:#8A3B2E"></span>Sold out</div>
                  {%- endif -%}
                  <div class="cl__foot">
                    <div class="cl__price-wrap">
                      {%- if csale -%}<span class="cl__rrp">RRP {{ product.compare_at_price | money }}</span>
                      {%- elsif cshow_rrp -%}<span class="cl__rrp">RRP {{ cmrsp_cents | money }}</span>{%- endif -%}
                      <div class="cl__pr mp-cond">{{ product.price | money }}</div>
                    </div>
                    {%- if product.available -%}
                      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                        <button type="submit" class="cl__add mp-cond">{% if cpre %}Pre-order{% else %}Add{% endif %}</button>
                      </form>
                    {%- else -%}
                      <a href="{{ product.url }}" class="cl__notify mp-cond">Notify me</a>
                    {%- endif -%}
                  </div>
                </div>
              </article>
            {%- endfor -%}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="cl__pager">
            <span class="cl__pager-info">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            <div class="cl__pages">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&lsaquo; Prev</a>{%- else -%}<span class="is-disabled">&lsaquo; Prev</span>{%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}<span class="is-current mp-cond">{{ part.title }}</span>
                {%- else -%}<span style="border:0;color:#A39C92">{{ part.title }}</span>{%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next &rsaquo;</a>{%- else -%}<span class="is-disabled">Next &rsaquo;</span>{%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="cl__empty">
          <h2 class="mp-cond">No games match these filters</h2>
          <p>Try adjusting your filters or browse the full collection.</p>
          <a href="{{ collection.url }}" class="mp-cond">Clear all filters</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}

    {%- if section.settings.finder_url != blank -%}
      <section class="cl__nudge" aria-label="Game finder">
        <div class="cl__nudge-text">
          <span class="cl__nudge-title mp-cond">{{ section.settings.finder_title }}</span>
          <span class="cl__nudge-sub">{{ section.settings.finder_sub }}</span>
        </div>
        <a class="cl__nudge-cta mp-cond" href="{{ section.settings.finder_url }}">{{ section.settings.finder_label }}</a>
      </section>
    {%- endif -%}

    {%- if collection.description != blank -%}
      <section class="cl__about" id="about" aria-label="About this collection">
        <h2 class="cl__about-heading mp-cond">{{ collection.title }}</h2>
        <div class="cl__about-body">{{ collection.description }}</div>
      </section>
    {%- endif -%}

  </div>
</section>

<script>
(function () {
  var grid = document.querySelector('.mp-cl-{{ section.id }} .cl__grid');
  if (!grid) return;
  var available = [], unavailable = [];
  grid.querySelectorAll('.cl__card').forEach(function (card) {
    (card.querySelector('.cl__notify') ? unavailable : available).push(card);
  });
  available.forEach(function (el) { grid.appendChild(el); });
  unavailable.forEach(function (el) { grid.appendChild(el); });
})();
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": {{ collection.title | json }},
      "url": {{ canonical_url | json }},
      {% if collection.description != blank %}"description": {{ collection.description | strip_html | truncatewords: 50 | json }},{% endif %}
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.products_count }},
        "itemListElement": [
          {%- assign pos = 0 -%}
          {%- for product in collection.products limit: 30 -%}
            {%- assign pos = pos | plus: 1 -%}
            { "@type": "ListItem", "position": {{ pos }}, "name": {{ product.title | json }}, "url": {{ shop.url | append: product.url | json }} }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: routes.root_url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ canonical_url | json }} }
      ]
    }
  ]
}
</script>

{% schema %}
{
  "name": "MP Collection",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 8, "max": 24, "step": 4, "label": "Products per page", "default": 12 },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_kicker", "label": "Kicker (eyebrow label)", "info": "Optional prefix before the product count, e.g. \"Category\"." },
    { "type": "color", "id": "hero_bg", "label": "Hero background colour", "default": "#14233A" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero art image", "info": "Overrides the collection image. Shown rotated on the right side of the hero." },
    { "type": "text", "id": "hero_link_label", "label": "Hero link label", "info": "Optional underlined link shown beneath the subtitle. Use collection metafields to set per-collection." },
    { "type": "url", "id": "hero_link_url", "label": "Hero link URL" },
    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "chips_menu", "label": "Subcategory chips menu", "info": "Optional pill nav of related collections shown beneath the hero." },
    { "type": "header", "content": "Game finder nudge" },
    { "type": "url", "id": "finder_url", "label": "Game finder URL", "info": "Leave blank to hide the nudge banner." },
    { "type": "text", "id": "finder_title", "label": "Nudge heading", "default": "Still not sure?" },
    { "type": "text", "id": "finder_sub", "label": "Nudge subtitle", "default": "Tell us who's playing and how long you've got — we'll narrow it down." },
    { "type": "text", "id": "finder_label", "label": "Nudge button label", "default": "Use the game finder" }
  ],
  "enabled_on": { "templates": ["collection"] },
  "presets": [
    { "name": "MP Collection" }
  ]
}
{% endschema %}
