{%- comment -%}
  MPGames pre-owned & trade-in band — green full-width section.
  Left: kicker, heading, body text and two CTA buttons.
  Right: 2×2 grid of mini product cards from a pre-owned collection.
{%- endcomment -%}

{%- style -%}
  .mp-po-{{ section.id }} { padding: 72px 24px 0; font-family: 'Barlow', ui-sans-serif, system-ui, sans-serif; }
  .mp-po-{{ section.id }} .mp-po__band {
    background: #1F5C3E;
    border-radius: 24px;
    padding: 40px 48px;
  }
  .mp-po-{{ section.id }} .mp-po__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
    align-items: center;
  }
  .mp-po-{{ section.id }} .mp-po__kicker {
    font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: #CFE8DA; margin: 0 0 8px;
  }
  .mp-po-{{ section.id }} .mp-po__heading {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 48px; font-weight: 800; color: #fff;
    text-transform: uppercase; line-height: 1; margin: 0 0 16px;
  }
  .mp-po-{{ section.id }} .mp-po__body {
    font-size: 15px; line-height: 1.6; color: #CFE8DA; margin: 0 0 24px; max-width: 380px;
  }
  .mp-po-{{ section.id }} .mp-po__actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .mp-po-{{ section.id }} .mp-po__btn {
    display: inline-flex; align-items: center; padding: 13px 22px; border-radius: 10px;
    font-size: 14px; font-weight: 700; text-decoration: none; white-space: nowrap;
  }
  .mp-po-{{ section.id }} .mp-po__btn--primary { background: #fff; color: #1F5C3E; }
  .mp-po-{{ section.id }} .mp-po__btn--primary:hover { background: #EDF5F0; }
  .mp-po-{{ section.id }} .mp-po__btn--ghost { border: 1.5px solid rgba(255,255,255,.45); color: #fff; }
  .mp-po-{{ section.id }} .mp-po__btn--ghost:hover { background: rgba(255,255,255,.1); }

  /* 2×2 grid of mini product cards */
  .mp-po-{{ section.id }} .mp-po__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .mp-po-{{ section.id }} .mp-po__card {
    background: #FBF7F0;
    border-radius: 14px;
    padding: 12px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: background .15s;
  }
  .mp-po-{{ section.id }} .mp-po__card:hover { background: #f0ebe0; }
  .mp-po-{{ section.id }} .mp-po__cthumb {
    width: 100%; aspect-ratio: 1/1; border-radius: 8px; overflow: hidden;
    background: #ECE3D3; display: flex; align-items: center; justify-content: center;
  }
  .mp-po-{{ section.id }} .mp-po__cthumb img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .mp-po-{{ section.id }} .mp-po__cname { font-size: 13px; font-weight: 600; color: #14233A; line-height: 1.2; }
  .mp-po-{{ section.id }} .mp-po__cprice {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 18px; font-weight: 800; color: #1F5C3E;
  }

  @media (max-width: 749px) {
    .mp-po-{{ section.id }} { padding-left: 16px; padding-right: 16px; }
    .mp-po-{{ section.id }} .mp-po__band { padding: 28px 22px; }
    .mp-po-{{ section.id }} .mp-po__heading { font-size: 36px; }
    .mp-po-{{ section.id }} .mp-po__inner { grid-template-columns: 1fr; gap: 28px; }
    .mp-po-{{ section.id }} .mp-po__cards { order: -1; }
  }
{%- endstyle -%}

<div class="mp-cream mp-po-{{ section.id }}">
  <div class="mp-col" style="padding-bottom:0">
    <div class="mp-po__band">
      <div class="mp-po__inner">
        <div>
          <p class="mp-po__kicker">{{ section.settings.kicker }}</p>
          <h2 class="mp-po__heading mp-cond">{{ section.settings.heading }}</h2>
          {%- if section.settings.body_text != blank -%}
            <p class="mp-po__body">{{ section.settings.body_text }}</p>
          {%- endif -%}
          <div class="mp-po__actions">
            {%- if section.settings.cta1_label != blank -%}
              <a class="mp-po__btn mp-po__btn--primary" href="{{ section.settings.cta1_url | default: '#' }}">{{ section.settings.cta1_label }}</a>
            {%- endif -%}
            {%- if section.settings.cta2_label != blank -%}
              <a class="mp-po__btn mp-po__btn--ghost" href="{{ section.settings.cta2_url | default: '#' }}">{{ section.settings.cta2_label }}</a>
            {%- endif -%}
          </div>
        </div>

        <div class="mp-po__cards">
          {%- if section.settings.collection != blank -%}
            {%- for product in section.settings.collection.products limit: 4 -%}
              <a class="mp-po__card" href="{{ product.url }}">
                <div class="mp-po__cthumb">
                  {%- if product.featured_image -%}
                    {{ product.featured_image | image_url: width: 240 | image_tag: alt: product.title, loading: 'lazy' }}
                  {%- endif -%}
                </div>
                <p class="mp-po__cname">{{ product.title | truncate: 38 }}</p>
                <p class="mp-po__cprice mp-cond">{{ product.price | money }}</p>
              </a>
            {%- else -%}
              {%- if request.design_mode -%}
                <p style="color:#CFE8DA;font-size:13px;grid-column:span 2">Select a pre-owned collection in the section settings.</p>
              {%- endif -%}
            {%- endfor -%}
          {%- elsif request.design_mode -%}
            <p style="color:#CFE8DA;font-size:13px;grid-column:span 2">Select a pre-owned collection in the section settings.</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "MP Pre-owned band",
  "settings": [
    { "type": "text",       "id": "kicker",      "label": "Kicker",           "default": "Pre-owned & trade in" },
    { "type": "text",       "id": "heading",     "label": "Heading",          "default": "Give your games a second life" },
    { "type": "textarea",   "id": "body_text",   "label": "Body text",        "default": "Sell your games to us or trade them in for store credit. We check, count and photograph every copy before it goes back on sale." },
    { "type": "text",       "id": "cta1_label",  "label": "Primary CTA label","default": "Browse pre-owned" },
    { "type": "url",        "id": "cta1_url",    "label": "Primary CTA URL" },
    { "type": "text",       "id": "cta2_label",  "label": "Secondary CTA label", "default": "Trade in your games" },
    { "type": "url",        "id": "cta2_url",    "label": "Secondary CTA URL" },
    { "type": "collection", "id": "collection",  "label": "Pre-owned collection", "info": "Shows the first 4 products." }
  ],
  "presets": [
    { "name": "MP Pre-owned band" }
  ]
}
{% endschema %}
