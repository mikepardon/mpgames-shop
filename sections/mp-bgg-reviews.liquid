{%- comment -%}
  MPGames BGG top 6 + customer reviews — side-by-side split panel.
  Left: white card with top-rated products ordered by BGG score.
  Right: purple reviews slider — fetches latest reviews from Judge.me API when
         api_token is set; falls back to manually configured review blocks.
{%- endcomment -%}

{%- style -%}
  .mp-br-{{ section.id }} {
    padding: 72px 24px 0;
    font-family: 'Barlow', ui-sans-serif, system-ui, sans-serif;
  }
  .mp-br-{{ section.id }} .mp-br__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 16px;
    align-items: stretch;
  }

  /* ── BGG left panel ── */
  .mp-br-{{ section.id }} .mp-br__bgg-card {
    background: #fff;
    border: 1px solid #ECE3D3;
    border-radius: 20px;
    padding: 28px 28px 20px;
  }
  .mp-br-{{ section.id }} .mp-br__kicker {
    font-size: 11px; font-weight: 700; letter-spacing: .1em;
    text-transform: uppercase; color: #B4530F; margin: 0 0 4px;
  }
  .mp-br-{{ section.id }} .mp-br__heading {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 36px; font-weight: 800; color: #14233A;
    text-transform: uppercase; line-height: 1; margin: 0 0 18px;
  }
  .mp-br-{{ section.id }} .mp-br__list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0; }
  .mp-br-{{ section.id }} .mp-br__row {
    display: flex; align-items: center; gap: 14px;
    padding: 10px 0; border-bottom: 1px solid #F5F0E8;
    text-decoration: none;
  }
  .mp-br-{{ section.id }} .mp-br__list li:last-child .mp-br__row { border-bottom: 0; }
  .mp-br-{{ section.id }} .mp-br__row:hover .mp-br__rname { color: #B4530F; }
  .mp-br-{{ section.id }} .mp-br__rank {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 32px; font-weight: 800; color: #C9BFAE; flex: none; width: 36px; text-align: center; line-height: 1;
  }
  .mp-br-{{ section.id }} .mp-br__rthumb {
    width: 44px; height: 54px; border-radius: 6px; overflow: hidden; flex: none;
    background: #F5F0E8; display: flex; align-items: center; justify-content: center;
  }
  .mp-br-{{ section.id }} .mp-br__rthumb img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .mp-br-{{ section.id }} .mp-br__rmeta { flex: 1; min-width: 0; }
  .mp-br-{{ section.id }} .mp-br__rname { font-size: 14px; font-weight: 600; color: #14233A; line-height: 1.2; transition: color .15s; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mp-br-{{ section.id }} .mp-br__rtype { font-size: 11.5px; color: #6A7686; margin-top: 2px; }
  .mp-br-{{ section.id }} .mp-br__rprice {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 18px; font-weight: 800; color: #14233A; flex: none; margin: 0 6px;
  }
  .mp-br-{{ section.id }} .mp-br__radd {
    border: 1.5px solid #14233A; color: #14233A; border-radius: 8px;
    padding: 6px 12px; font-size: 12px; font-weight: 600; background: transparent;
    cursor: pointer; font-family: inherit; flex: none;
  }
  .mp-br-{{ section.id }} .mp-br__radd:hover { background: #14233A; color: #fff; }
  .mp-br-{{ section.id }} .mp-br__radd[disabled] { opacity: .4; cursor: not-allowed; }
  .mp-br-{{ section.id }} .mp-br__raddform { margin: 0; }

  /* ── Reviews right panel ── */
  .mp-br-{{ section.id }} .mp-br__rev-card {
    background: #3A2A56;
    border-radius: 20px;
    padding: 32px;
    display: flex;
    flex-direction: column;
  }
  .mp-br-{{ section.id }} .mp-br__rev-kicker {
    font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: #D9CCF0; margin: 0 0 12px;
  }
  .mp-br-{{ section.id }} .mp-br__score {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 72px; font-weight: 800; color: #fff; line-height: 1; margin: 0;
  }
  .mp-br-{{ section.id }} .mp-br__stars { display: flex; gap: 4px; margin-top: 6px; }
  .mp-br-{{ section.id }} .mp-br__star { color: #F5B841; font-size: 20px; }
  .mp-br-{{ section.id }} .mp-br__rev-count { font-size: 13px; color: #D9CCF0; margin-top: 4px; }

  /* ── Slider ── */
  .mp-br-{{ section.id }} .mp-br__slider { flex: 1; display: flex; flex-direction: column; margin-top: 20px; min-height: 0; }
  .mp-br-{{ section.id }} .mp-br__slide { display: none; flex-direction: column; flex: 1; }
  .mp-br-{{ section.id }} .mp-br__slide.is-active { display: flex; animation: mp-br-fade .35s; }
  @keyframes mp-br-fade { from { opacity: 0 } to { opacity: 1 } }
  .mp-br-{{ section.id }} .mp-br__slide-stars { display: flex; gap: 3px; margin-bottom: 10px; }
  .mp-br-{{ section.id }} .mp-br__slide-star { font-size: 16px; }
  .mp-br-{{ section.id }} .mp-br__slide-star--filled { color: #F5B841; }
  .mp-br-{{ section.id }} .mp-br__slide-star--empty { color: rgba(255,255,255,.2); }
  .mp-br-{{ section.id }} .mp-br__slide-quote {
    flex: 1; font-size: 15px; line-height: 1.55; color: #E8E0F5; font-style: italic; margin: 0;
  }
  .mp-br-{{ section.id }} .mp-br__slide-quote::before { content: '\201C'; }
  .mp-br-{{ section.id }} .mp-br__slide-quote::after { content: '\201D'; }
  .mp-br-{{ section.id }} .mp-br__slide-reviewer { font-size: 13px; color: #D9CCF0; margin-top: 10px; font-style: normal; }
  .mp-br-{{ section.id }} .mp-br__slide-product {
    margin-top: 14px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,.12);
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
  }
  .mp-br-{{ section.id }} .mp-br__slide-pname { font-size: 14px; font-weight: 600; color: #fff; }
  .mp-br-{{ section.id }} .mp-br__slide-shop {
    border: 1.5px solid rgba(255,255,255,.4); border-radius: 8px; padding: 7px 14px;
    font-size: 13px; font-weight: 600; color: #fff; text-decoration: none; white-space: nowrap;
    transition: background .15s; flex: none;
  }
  .mp-br-{{ section.id }} .mp-br__slide-shop:hover { background: rgba(255,255,255,.12); }

  /* ── Slider navigation ── */
  .mp-br-{{ section.id }} .mp-br__slider-nav {
    display: flex; align-items: center; justify-content: space-between; margin-top: 16px; flex: none;
  }
  .mp-br-{{ section.id }} .mp-br__dots { display: flex; gap: 6px; align-items: center; }
  .mp-br-{{ section.id }} .mp-br__dot {
    width: 7px; height: 7px; border-radius: 50%; background: rgba(255,255,255,.3);
    border: 0; cursor: pointer; padding: 0; transition: background .2s;
  }
  .mp-br-{{ section.id }} .mp-br__dot.is-active { background: #fff; }
  .mp-br-{{ section.id }} .mp-br__nav-btns { display: flex; gap: 6px; }
  .mp-br-{{ section.id }} .mp-br__nav-btn {
    background: rgba(255,255,255,.12); border: 0; color: #fff; border-radius: 6px;
    width: 30px; height: 30px; cursor: pointer; font-size: 20px; display: flex;
    align-items: center; justify-content: center; transition: background .15s; line-height: 1;
  }
  .mp-br-{{ section.id }} .mp-br__nav-btn:hover { background: rgba(255,255,255,.25); }

  @media (max-width: 900px) {
    .mp-br-{{ section.id }} .mp-br__grid { grid-template-columns: 1fr; }
    .mp-br-{{ section.id }} { padding-left: 16px; padding-right: 16px; }
    .mp-br-{{ section.id }} .mp-br__heading { font-size: 24px; }
  }
  @media (max-width: 749px) {
    /* Grid items default to min-width:auto which lets them expand beyond 1fr — reset both panels */
    .mp-br-{{ section.id }} .mp-br__bgg-card,
    .mp-br-{{ section.id }} .mp-br__rev-card { min-width: 0; overflow: hidden; }
    .mp-br-{{ section.id }} .mp-br__bgg-card { padding: 20px 16px 16px; }
    .mp-br-{{ section.id }} .mp-br__heading { overflow-wrap: break-word; word-break: break-word; }
    .mp-br-{{ section.id }} .mp-br__rprice,
    .mp-br-{{ section.id }} .mp-br__raddform { display: none; }
    .mp-br-{{ section.id }} .mp-br__rev-card { padding: 24px 20px; }
    .mp-br-{{ section.id }} .mp-br__slider,
    .mp-br-{{ section.id }} .mp-br__slide { min-width: 0; }
    .mp-br-{{ section.id }} .mp-br__slide-quote { overflow-wrap: break-word; word-break: break-word; }
    .mp-br-{{ section.id }} .mp-br__slide-product { flex-wrap: wrap; gap: 8px; }
  }
{%- endstyle -%}

<div class="mp-cream mp-br-{{ section.id }}">
  <div class="mp-col" style="padding-bottom:0">
    <div class="mp-br__grid">

      <!-- BGG top list -->
      <div class="mp-br__bgg-card">
        <p class="mp-br__kicker">{{ section.settings.kicker }}</p>
        <h2 class="mp-br__heading mp-cond">{{ section.settings.heading }}</h2>
        {%- liquid
          assign bgg_source = section.settings.collection.products
          if section.settings.collection == blank
            assign bgg_source = collections.all.products
          endif
          assign bgg_keyed = ''
          for p in bgg_source
            assign r = p.metafields.custom.bgg_rating.value | default: 0 | times: 10 | round | plus: 100000
            assign bgg_keyed = bgg_keyed | append: r | append: '|' | append: p.handle | append: ','
          endfor
          assign bgg_keyed = bgg_keyed | split: ',' | sort | reverse
          assign bgg_shown = 0
        -%}
        <ul class="mp-br__list">
          {%- for entry in bgg_keyed -%}
            {%- if entry == blank -%}{%- continue -%}{%- endif -%}
            {%- if bgg_shown >= 6 -%}{%- break -%}{%- endif -%}
            {%- assign parts = entry | split: '|' -%}
            {%- assign want = parts[1] -%}
            {%- assign bgg_product = nil -%}
            {%- for p in bgg_source -%}{%- if p.handle == want -%}{%- assign bgg_product = p -%}{%- break -%}{%- endif -%}{%- endfor -%}
            {%- if bgg_product.handle != want -%}{%- continue -%}{%- endif -%}
            {%- assign bgg_shown = bgg_shown | plus: 1 -%}
            <li>
              <a class="mp-br__row" href="{{ bgg_product.url }}">
                <span class="mp-br__rank mp-cond">{{ bgg_shown }}</span>
                <span class="mp-br__rthumb">
                  {%- if bgg_product.featured_image -%}
                    {{ bgg_product.featured_image | image_url: width: 100 | image_tag: alt: bgg_product.title, loading: 'lazy', width: 44, height: 54 }}
                  {%- endif -%}
                </span>
                <span class="mp-br__rmeta">
                  <span class="mp-br__rname">{{ bgg_product.title }}</span>
                  <span class="mp-br__rtype">{{ bgg_product.type }}</span>
                </span>
                <span class="mp-br__rprice mp-cond">{{ bgg_product.price | money }}</span>
                <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="mp-br__raddform">
                  <input type="hidden" name="id" value="{{ bgg_product.selected_or_first_available_variant.id }}">
                  <button type="submit" class="mp-br__radd"{% unless bgg_product.available %} disabled{% endunless %}>
                    {%- if bgg_product.available -%}Add{%- else -%}Out{%- endif -%}
                  </button>
                </form>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      <!-- Reviews slider -->
      <div class="mp-br__rev-card">
        <p class="mp-br__rev-kicker">{{ section.settings.reviews_kicker }}</p>
        {%- liquid
          assign jm_rating = shop.metafields.judgeme.rating.value | default: section.settings.rating_fallback
          assign jm_count = shop.metafields.judgeme.all_reviews_count.value | default: section.settings.count_fallback
        -%}
        <p class="mp-br__score mp-cond">{{ jm_rating }}</p>
        <div class="mp-br__stars" aria-label="{{ jm_rating }} out of 5 stars">
          <span class="mp-br__star">&#9733;</span>
          <span class="mp-br__star">&#9733;</span>
          <span class="mp-br__star">&#9733;</span>
          <span class="mp-br__star">&#9733;</span>
          <span class="mp-br__star">&#9733;</span>
        </div>
        {%- if jm_count != blank -%}
          <p class="mp-br__rev-count">{{ jm_count }} verified reviews</p>
        {%- endif -%}

        <div class="mp-br__slider"
             id="mp-br-slider-{{ section.id }}"
             data-autoplay="5000">

          {%- for block in section.blocks -%}
            {%- assign block_rating = block.settings.rating | default: 5 -%}
            <div class="mp-br__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
              <div class="mp-br__slide-stars">
                {%- for star_i in (1..5) -%}
                  <span class="mp-br__slide-star mp-br__slide-star--{% if star_i <= block_rating %}filled{% else %}empty{% endif %}">&#9733;</span>
                {%- endfor -%}
              </div>
              <p class="mp-br__slide-quote">{{ block.settings.body }}</p>
              <p class="mp-br__slide-reviewer">&#8212; {{ block.settings.reviewer }}</p>
              {%- if block.settings.product_name != blank -%}
                <div class="mp-br__slide-product">
                  <span class="mp-br__slide-pname">{{ block.settings.product_name }}</span>
                  {%- if block.settings.product_url != blank -%}
                    <a class="mp-br__slide-shop" href="{{ block.settings.product_url }}">Shop now</a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}

          <div class="mp-br__slider-nav">
            <div class="mp-br__dots"></div>
            <div class="mp-br__nav-btns">
              <button class="mp-br__nav-btn mp-br__nav-btn--prev" aria-label="Previous review">&#8249;</button>
              <button class="mp-br__nav-btn mp-br__nav-btn--next" aria-label="Next review">&#8250;</button>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
(function () {
  var slider = document.getElementById('mp-br-slider-{{ section.id }}');
  if (!slider) return;

  var delay   = parseInt(slider.dataset.autoplay) || 5000;
  var current = 0;
  var timer;

  function getSlides() {
    return Array.from(slider.querySelectorAll('.mp-br__slide'));
  }

  function buildDots(slides) {
    var dotsEl = slider.querySelector('.mp-br__dots');
    dotsEl.innerHTML = '';
    slides.forEach(function (_, i) {
      var d = document.createElement('button');
      d.className = 'mp-br__dot' + (i === 0 ? ' is-active' : '');
      d.setAttribute('aria-label', 'Review ' + (i + 1));
      d.addEventListener('click', function () { go(i); });
      dotsEl.appendChild(d);
    });
  }

  function go(index) {
    var slides = getSlides();
    var dots   = Array.from(slider.querySelectorAll('.mp-br__dot'));
    slides[current].classList.remove('is-active');
    if (dots[current]) dots[current].classList.remove('is-active');
    current = (index + slides.length) % slides.length;
    slides[current].classList.add('is-active');
    if (dots[current]) dots[current].classList.add('is-active');
  }

  function startAutoplay() {
    timer = setInterval(function () { go(current + 1); }, delay);
  }

  function init() {
    var slides = getSlides();
    if (slides.length === 0) return;
    buildDots(slides);
    if (slides.length > 1) {
      slider.querySelector('.mp-br__nav-btn--prev').addEventListener('click', function () {
        clearInterval(timer); go(current - 1); startAutoplay();
      });
      slider.querySelector('.mp-br__nav-btn--next').addEventListener('click', function () {
        clearInterval(timer); go(current + 1); startAutoplay();
      });
      slider.addEventListener('mouseenter', function () { clearInterval(timer); });
      slider.addEventListener('mouseleave', startAutoplay);
      startAutoplay();
    }
  }

  function starsHtml(rating) {
    var html = '<div class="mp-br__slide-stars">';
    for (var s = 1; s <= 5; s++) {
      html += '<span class="mp-br__slide-star mp-br__slide-star--' + (s <= rating ? 'filled' : 'empty') + '">&#9733;</span>';
    }
    return html + '</div>';
  }

  function renderApiReviews(reviews) {
    var nav = slider.querySelector('.mp-br__slider-nav');
    getSlides().forEach(function (el) { el.remove(); });
    current = 0;

    reviews.forEach(function (r, i) {
      var slide = document.createElement('div');
      slide.className = 'mp-br__slide' + (i === 0 ? ' is-active' : '');

      var starsDiv = document.createElement('div');
      starsDiv.innerHTML = starsHtml(r.rating || 5);
      slide.appendChild(starsDiv.firstChild);

      var quote = document.createElement('p');
      quote.className = 'mp-br__slide-quote';
      quote.textContent = r.body || '';

      var reviewer = document.createElement('p');
      reviewer.className = 'mp-br__slide-reviewer';
      reviewer.textContent = '— ' + (r.reviewer && r.reviewer.name ? r.reviewer.name : 'Verified buyer');

      slide.appendChild(quote);
      slide.appendChild(reviewer);

      if (r.product_title) {
        var productDiv = document.createElement('div');
        productDiv.className = 'mp-br__slide-product';

        var pname = document.createElement('span');
        pname.className = 'mp-br__slide-pname';
        pname.textContent = r.product_title;

        var shopLink = document.createElement('a');
        shopLink.className = 'mp-br__slide-shop';
        shopLink.textContent = 'Shop now';
        shopLink.href = '/products/' + encodeURIComponent(r.product_handle || '');

        productDiv.appendChild(pname);
        productDiv.appendChild(shopLink);
        slide.appendChild(productDiv);
      }

      slider.insertBefore(slide, nav);
    });
  }

  fetch('/apps/notify/proxy-reviews')
    .then(function (res) { return res.json(); })
    .then(function (data) {
      if (data.reviews && data.reviews.length > 0) {
        renderApiReviews(data.reviews);
      }
      init();
    })
    .catch(function () { init(); });
})();
</script>

{% schema %}
{
  "name": "MP BGG + Reviews",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "review",
      "name": "Review quote",
      "settings": [
        { "type": "textarea", "id": "body",         "label": "Review text" },
        { "type": "text",     "id": "reviewer",     "label": "Reviewer name",  "default": "Verified buyer" },
        { "type": "range",    "id": "rating",        "label": "Star rating",    "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text",     "id": "product_name", "label": "Product name",   "info": "Shown at the bottom of this review card." },
        { "type": "url",      "id": "product_url",  "label": "Product URL" }
      ]
    }
  ],
  "settings": [
    { "type": "text",       "id": "kicker",          "label": "BGG kicker",           "default": "The hobbyist corner" },
    { "type": "text",       "id": "heading",         "label": "BGG heading",          "default": "Highest rated on BoardGameGeek" },
    { "type": "collection", "id": "collection",      "label": "Collection",           "info": "Products sorted by custom.bgg_rating metafield. Defaults to all products." },
    { "type": "text",       "id": "reviews_kicker",  "label": "Reviews kicker",       "default": "Customers are saying" },
    { "type": "text",       "id": "rating_fallback", "label": "Rating fallback",      "default": "4.93", "info": "Shown if Judge.me metafield is not set." },
    { "type": "text",       "id": "count_fallback",  "label": "Review count fallback",                  "info": "Shown if Judge.me metafield is not set." },
    { "type": "text",       "id": "jm_api_token",    "label": "Judge.me API token",   "info": "From Judge.me admin > Settings > API. When set, the slider auto-fetches the 3 latest reviews. Leave blank to use the review blocks below." }
  ],
  "presets": [
    { "name": "MP BGG + Reviews" }
  ]
}
{% endschema %}
