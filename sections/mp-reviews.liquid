{%- comment -%}
  MPGames all-reviews page. Judge.me's app embed (loaded site-wide via content_for_header)
  picks up the .jdgm-all-reviews-widget div and populates it automatically.
{%- endcomment -%}

{%- style -%}
  .mp-rv-{{ section.id }} {
    background: #f4efe6;
    font-family: 'Barlow', ui-sans-serif, system-ui, sans-serif;
    min-height: 60vh;
  }
  .mp-rv-{{ section.id }} .rv__wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 28px 64px;
  }
  .mp-rv-{{ section.id }} .rv__kicker {
    font-size: 12px; font-weight: 700; letter-spacing: .6px;
    color: #f2872f; text-transform: uppercase; margin-bottom: 6px;
  }
  .mp-rv-{{ section.id }} .rv__h {
    font-size: 32px; font-weight: 700; color: #16323f;
    line-height: 1.1; margin: 0 0 6px;
  }
  .mp-rv-{{ section.id }} .rv__sub {
    font-size: 15px; color: #6b7a82; margin: 0 0 32px;
  }
  .mp-rv-{{ section.id }} .rv__summary {
    display: flex; align-items: center; gap: 10px;
    margin-bottom: 28px;
  }
  .mp-rv-{{ section.id }} .rv__stars { color: #f4b942; font-size: 20px; letter-spacing: 2px; }
  .mp-rv-{{ section.id }} .rv__score { font-size: 22px; font-weight: 700; color: #16323f; }
  .mp-rv-{{ section.id }} .rv__cnt { font-size: 14px; color: #6b7a82; }
  .mp-rv-{{ section.id }} .rv__widget { background: #fff; border-radius: 14px; padding: 28px; border: 1px solid #e7ddcb; }
  @media (max-width: 749px) {
    .mp-rv-{{ section.id }} .rv__wrap { padding: 24px 16px 40px; }
    .mp-rv-{{ section.id }} .rv__h { font-size: 24px; }
  }
{%- endstyle -%}

{%- liquid
  assign jm_count  = shop.metafields.judgeme.all_reviews_count
  assign jm_rating = shop.metafields.judgeme.all_reviews_rating
-%}

<div class="mp-rv-{{ section.id }} mp-cond">
  <div class="rv__wrap">
    <div class="rv__kicker">MPGames customer reviews</div>
    <h1 class="rv__h">{{ section.settings.title }}</h1>
    <p class="rv__sub">{{ section.settings.subtitle }}</p>

    {%- if jm_count != blank and jm_count > 0 -%}
      <div class="rv__summary">
        <span class="rv__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="rv__score">{{ jm_rating | round: 2 }}</span>
        <span class="rv__cnt">from {{ jm_count }} verified reviews</span>
      </div>
    {%- endif -%}

    <div class="rv__widget">
      <div class="jdgm-widget jdgm-all-reviews-widget" data-branch-key=""></div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "MP Reviews page",
  "settings": [
    { "type": "text", "id": "title", "label": "Page title", "default": "Customer Reviews" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Real reviews from real board gamers." }
  ],
  "presets": [
    { "name": "MP Reviews page" }
  ]
}
{% endschema %}
