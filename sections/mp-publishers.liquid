{%- comment -%}
  MPGames "Shop by publisher" grid. Imported from Claude Design.
{%- endcomment -%}

{%- style -%}
  .mp-pub-{{ section.id }} .mp-pub__pad { padding: 72px 24px 6px; }
  .mp-pub-{{ section.id }} .mp-pub__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
  .mp-pub-{{ section.id }} .mp-pub__kicker { font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #B4530F; margin: 0 0 4px; }
  .mp-pub-{{ section.id }} .mp-pub__title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 44px; font-weight: 800; color: #14233A;
    text-transform: uppercase; line-height: 1; margin: 0;
  }
  .mp-pub-{{ section.id }} .mp-pub__all { font-size: 13px; color: #B4530F; font-weight: 600; text-decoration: none; }
  .mp-pub-{{ section.id }} .mp-pub__grid { display: flex; flex-wrap: wrap; gap: 10px; }
  .mp-pub-{{ section.id }} .mp-pub__cell {
    border: 1px solid #ECE3D3; border-radius: 999px; min-height: 48px;
    display: inline-flex; flex-direction: row; gap: 10px;
    align-items: center; background: #fff; padding: 8px 16px 8px 10px; text-decoration: none;
    transition: border-color .15s, background .15s;
  }
  .mp-pub-{{ section.id }} .mp-pub__cell:hover { border-color: #14233A; background: #F5F0E8; }
  .mp-pub-{{ section.id }} .mp-pub__av { width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: #fff; flex: none; }
  .mp-pub-{{ section.id }} .mp-pub__av--logo { background: #fff; border: 1px solid #ECE3D3; overflow: hidden; padding: 3px; box-sizing: border-box; }
  .mp-pub-{{ section.id }} .mp-pub__av--logo img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .mp-pub-{{ section.id }} .mp-pub__name { font-size: 14px; font-weight: 700; color: #14233A; letter-spacing: .1px; line-height: 1.2; white-space: nowrap; }
  @media (max-width: 749px) {
    .mp-pub-{{ section.id }} .mp-pub__pad { padding: 72px 16px 6px; }
    .mp-pub-{{ section.id }} { display: none; }
  }
{%- endstyle -%}

<div class="mp-cream mp-pub-{{ section.id }}">
  <div class="mp-col">
    <div class="mp-pub__pad">
      <div class="mp-pub__head">
        <div>
          {%- if section.settings.kicker != blank -%}<p class="mp-pub__kicker">{{ section.settings.kicker }}</p>{%- endif -%}
          <h2 class="mp-pub__title mp-cond">{{ section.settings.title }}</h2>
        </div>
        {%- if section.settings.link_label != blank -%}
          <a class="mp-pub__all" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_label }} &#8594;</a>
        {%- endif -%}
      </div>
      <div class="mp-pub__grid">
        {%- assign source = section.settings.collection -%}
        {%- if source != blank -%}
          {%- assign vendors = source.products | map: 'vendor' | uniq -%}
          {%- assign pub_palette = '#2c5466,#2f8f5b,#9a3b2e,#6a4f86,#c2772a,#16323f' | split: ',' -%}
          {%- assign logo_handles = section.settings.logo_handles | split: ',' -%}
          {%- for vendor in vendors limit: section.settings.count -%}
            {%- if vendor != blank -%}
              {%- capture vhandle -%}{%- render 'tidy-handle', name: vendor -%}{%- endcapture -%}
              {%- assign vw = vendor | split: ' ' -%}
              {%- assign initials = vw[0] | slice: 0 -%}
              {%- if vw.size > 1 -%}{%- assign second = vw[1] | slice: 0 -%}{%- assign initials = initials | append: second -%}{%- endif -%}
              {%- assign cidx = forloop.index0 | modulo: 6 -%}
              {%- assign pcolor = pub_palette[cidx] -%}
              <a class="mp-pub__cell" href="/collections/publisher-{{ vhandle }}">
                {%- assign pub_handle = 'publisher-' | append: vhandle -%}{%- assign pub_col = collections[pub_handle] -%}{%- if pub_col.image != blank -%}<span class="mp-pub__av mp-pub__av--logo"><img src="{{ pub_col.image | image_url: width: 64 }}" alt="{{ vendor | escape }}" width="32" height="32" loading="lazy"></span>{%- elsif logo_handles contains vhandle -%}
                  <span class="mp-pub__av mp-pub__av--logo"><img src="{{ 'pub-' | append: vhandle | append: '.png' | asset_url }}" alt="{{ vendor | escape }}" width="32" height="32" loading="lazy"></span>
                {%- else -%}
                  <span class="mp-pub__av mp-cond" style="background:{{ pcolor }}">{{ initials | upcase }}</span>
                {%- endif -%}
                <span class="mp-pub__name mp-cond">{{ vendor }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        {%- elsif request.design_mode -%}
          <p style="color:#8a8278;font-size:13px">Pick a collection in this section's settings — publishers are read from its products.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "MP Publishers",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker (eyebrow text)", "default": "Discover brands" },
    { "type": "text", "id": "title", "label": "Title", "default": "Shop by publisher" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Publisher names are the unique vendors of this collection's products." },
    { "type": "range", "id": "count", "min": 4, "max": 24, "step": 1, "label": "Max publishers", "default": 12 },
    { "type": "text", "id": "logo_handles", "label": "Publisher logo handles", "info": "Vendor handles with a pub-<handle>.png asset; others show a monogram.", "default": "stonemaier-games,roxley-games,z-man-games,cephalofair-games,stronghold-games,capstone-games,greater-than-games,plan-b-games,catan-studio,days-of-wonder,flatout-games,starling-games,repos-production,space-cowboys,leder-games,dire-wolf,czech-games-edition,kosmos,cocktail-games,delicious-games,burnt-island-games" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All brands" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "presets": [
    { "name": "MP Publishers", "settings": { "title": "Shop by publisher", "count": 12 } }
  ]
}
{% endschema %}
