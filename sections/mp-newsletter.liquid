{%- comment -%}
  MPGames newsletter sign-up band. Imported from Claude Design.
  Relays sign-ups to our own /apps/notify app proxy (type: newsletter).
{%- endcomment -%}

{%- style -%}
  .mp-nl-{{ section.id }} .mp-nl__wrap { padding: 72px 24px 36px; }
  .mp-nl-{{ section.id }} .mp-nl__card {
    border-radius: 24px; background: #14233A; padding: 40px 48px;
    display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center;
  }
  .mp-nl-{{ section.id }} .mp-nl__kicker { font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #F59A3A; margin: 0 0 8px; }
  .mp-nl-{{ section.id }} .mp-nl__title {
    font-family: 'Barlow Condensed', sans-serif;
    color: #fff; font-size: 44px; font-weight: 800; text-transform: uppercase;
    line-height: 1; margin: 0 0 16px;
  }
  .mp-nl-{{ section.id }} .mp-nl__sub { color: #8da8bb; font-size: 13.5px; margin-top: 6px; }
  .mp-nl-{{ section.id }} .mp-nl__perks { list-style: none; padding: 0; margin: 16px 0 0; display: flex; flex-direction: column; gap: 10px; }
  .mp-nl-{{ section.id }} .mp-nl__perk { display: flex; align-items: center; gap: 10px; font-size: 14px; color: #C4D8E6; }
  .mp-nl-{{ section.id }} .mp-nl__perk::before { content: '✓'; display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; background: #F59A3A; color: #14233A; font-size: 11px; font-weight: 700; flex: none; }
  .mp-nl-{{ section.id }} .mp-nl__form { display: flex; flex-direction: column; gap: 10px; align-items: stretch; }
  .mp-nl-{{ section.id }} .mp-nl__row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .mp-nl-{{ section.id }} .mp-nl__form input[type="email"] {
    background: #fff; border: 0; border-radius: 10px; padding: 14px 18px; font-size: 14px;
    color: #14233A; min-width: 220px; font-family: inherit; outline: 0; flex: 1;
  }
  .mp-nl-{{ section.id }} .mp-nl__consent { display: flex; gap: 8px; align-items: flex-start; color: #8da8bb; font-size: 11.5px; line-height: 1.45; cursor: pointer; }
  .mp-nl-{{ section.id }} .mp-nl__consent input { width: 15px; height: 15px; margin: 2px 0 0; flex: none; accent-color: #F59A3A; }
  .mp-nl-{{ section.id }} .mp-nl__consent a { color: #F59A3A; }
  .mp-nl-{{ section.id }} .mp-nl__form button {
    background: #F59A3A; color: #14233A; font-weight: 700; font-size: 14.5px; padding: 14px 26px;
    border-radius: 10px; white-space: nowrap; border: 0; cursor: pointer; font-family: inherit;
  }
  .mp-nl-{{ section.id }} .mp-nl__form button:hover { background: #e8891e; }
  .mp-nl-{{ section.id }} .mp-nl__ok { color: #bfe9d2; font-size: 13px; margin-top: 8px; }
  .mp-nl-{{ section.id }} .mp-nl__err { color: #ffd2c7; font-size: 13px; margin-top: 8px; }
  .mp-nl-{{ section.id }} [data-nl-fields][hidden], .mp-nl-{{ section.id }} [data-nl-consent][hidden], .mp-nl-{{ section.id }} .mp-nl__ok[hidden], .mp-nl-{{ section.id }} .mp-nl__err[hidden] { display: none; }
  .mp-nl-{{ section.id }} .mp-nl__form button[disabled] { opacity: .6; cursor: default; }
  @media (max-width: 749px) {
    .mp-nl-{{ section.id }} .mp-nl__wrap { padding: 72px 16px 32px; }
    .mp-nl-{{ section.id }} .mp-nl__card { grid-template-columns: 1fr; padding: 28px 24px; gap: 28px; }
    .mp-nl-{{ section.id }} .mp-nl__row { flex-direction: column; align-items: stretch; }
    .mp-nl-{{ section.id }} .mp-nl__form input[type="email"] { min-width: 0; width: 100%; box-sizing: border-box; }
    .mp-nl-{{ section.id }} .mp-nl__form button { width: 100%; }
  }
{%- endstyle -%}

<div class="mp-cream mp-nl-{{ section.id }}">
  <div class="mp-col">
    <div class="mp-nl__wrap">
      <div class="mp-nl__card">
        <div>
          {%- if section.settings.kicker != blank -%}<p class="mp-nl__kicker">{{ section.settings.kicker }}</p>{%- endif -%}
          <h2 class="mp-nl__title mp-cond">{{ section.settings.title }}</h2>
          {%- if section.settings.subtitle != blank -%}<div class="mp-nl__sub">{{ section.settings.subtitle }}</div>{%- endif -%}
          {%- if section.settings.perk_1 != blank or section.settings.perk_2 != blank or section.settings.perk_3 != blank -%}
            <ul class="mp-nl__perks">
              {%- if section.settings.perk_1 != blank -%}<li class="mp-nl__perk">{{ section.settings.perk_1 }}</li>{%- endif -%}
              {%- if section.settings.perk_2 != blank -%}<li class="mp-nl__perk">{{ section.settings.perk_2 }}</li>{%- endif -%}
              {%- if section.settings.perk_3 != blank -%}<li class="mp-nl__perk">{{ section.settings.perk_3 }}</li>{%- endif -%}
            </ul>
          {%- endif -%}
        </div>
        {%- comment -%} Relays the sign-up to our own /apps/notify app proxy (type: newsletter) rather than Shopify's customer form. {%- endcomment -%}
        <form class="mp-nl__form" data-nl-form novalidate>
          <div class="mp-nl__row" data-nl-fields>
            <input type="email" name="email" placeholder="{{ section.settings.placeholder }}" aria-label="Email" required>
            <button type="submit">{{ section.settings.button_label }}</button>
          </div>
          <label class="mp-nl__consent" data-nl-consent>
            <input type="checkbox" name="consent" value="true" required>
            <span>{{ section.settings.consent_text }}{%- if shop.privacy_policy != blank %} <a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>{%- endif -%}.</span>
          </label>
          <p class="mp-nl__err" data-nl-err hidden></p>
          <p class="mp-nl__ok" data-nl-ok hidden>{{ section.settings.success_text }}</p>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('.mp-nl-{{ section.id }}');
    if (!root) return;
    var form = root.querySelector('[data-nl-form]');
    if (!form) return;

    var emailInput = form.querySelector('input[type="email"]');
    var consent = form.querySelector('input[name="consent"]');
    var fields = form.querySelector('[data-nl-fields]');
    var consentRow = form.querySelector('[data-nl-consent]');
    var okEl = form.querySelector('[data-nl-ok]');
    var errEl = form.querySelector('[data-nl-err]');
    var submitBtn = form.querySelector('button[type="submit"]');
    var customerName = {{ customer.name | json }};

    function showError(message) {
      if (!errEl) return;
      errEl.textContent = message;
      errEl.hidden = false;
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      if (errEl) errEl.hidden = true;

      var email = ((emailInput && emailInput.value) || '').trim();
      if (!email) { showError('Please enter your email address.'); return; }
      if (consent && !consent.checked) { showError('Please tick the box to confirm you’re happy to hear from us.'); return; }

      var originalLabel = submitBtn ? submitBtn.textContent : '';
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Signing up…'; }

      fetch('/apps/notify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ type: 'newsletter', email: email, name: customerName })
      }).then(function (response) {
        if (!response.ok) { throw new Error('newsletter relay returned ' + response.status); }
        return response.json().catch(function () { return {}; });
      }).then(function () {
        if (fields) fields.hidden = true;
        if (consentRow) consentRow.hidden = true;
        if (okEl) okEl.hidden = false;
      }).catch(function () {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = originalLabel; }
        showError('Sorry, something went wrong. Please try again.');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "MP Newsletter",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker (eyebrow text)", "default": "Club members" },
    { "type": "text", "id": "title", "label": "Title", "default": "Join the MPGames club" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Early access to restocks, new releases and the guides we publish each week." },
    { "type": "text", "id": "perk_1", "label": "Perk 1", "default": "Earn [X] points per £1 spent" },
    { "type": "text", "id": "perk_2", "label": "Perk 2", "default": "First to know about restocks and new arrivals" },
    { "type": "text", "id": "perk_3", "label": "Perk 3", "default": "Exclusive subscriber discounts" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Enter your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign up" },
    { "type": "text", "id": "success_text", "label": "Success text", "default": "Thanks for subscribing!" },
    { "type": "text", "id": "consent_text", "label": "Consent text", "default": "Yes, email me restocks, new releases and offers. I can unsubscribe anytime — see our " }
  ],
  "presets": [ { "name": "MP Newsletter" } ]
}
{% endschema %}
