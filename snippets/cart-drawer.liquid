{% comment %}
  Renders cart drawer

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<style>
  .drawer { visibility: hidden; }
  .cart-drawer .cart-drawer__footer { padding-right: 1.2rem; }
  /* Cart item rows: 3-col grid */
  .mp-cart-items { display: block; }
  .cart-drawer .mp-cart-item { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 1rem; align-items: start; padding: 1.2rem 1.6rem 1.2rem 0; border-bottom: 1px solid #edf1f3; }
  .mp-cart-item__media { width: 80px; }
  .mp-cart-item__img { width: 80px; height: 80px; object-fit: cover; border-radius: 6px; display: block; }
  .mp-cart-item__body { min-width: 0; }
  .mp-cart-item__name { font-weight: 600; color: #16323f; text-decoration: none; line-height: 1.35; display: block; margin-bottom: 0.25rem; }
  .mp-cart-item__name:hover { color: #f2872f; }
  .mp-cart-item__opts { font-size: 0.82rem; color: #4a6570; margin: 0 0 0.35rem; }
  .mp-cart-item__stepper { margin-top: 0.55rem; }
  .cart-drawer .mp-cart-quantity { width: 9rem; }
  .cart-drawer .quantity__button { width: calc(2.5rem / var(--font-body-scale)); }
  .mp-cart-item__right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.35rem; }
  .mp-cart-item__price { text-align: right; position: relative; }
  .mp-cart-item__price .price { font-weight: 700; display: block; }
  .mp-cart-item__price .cart-item__old-price { color: #9fb4bd; font-size: 0.82rem; display: block; text-align: right; text-decoration: line-through; }
  .mp-cart-item__price .cart-item__old-price::before { content: "RRP: "; }
  /* × remove button */
  .mp-cart-remove-x { background: none; border: none; color: #9fb4bd; font-size: 1.4rem; line-height: 1; cursor: pointer; padding: 0.1rem 0.3rem; font-family: inherit; }
  .mp-cart-remove-x:hover { color: #16323f; }
  /* Wishlist 4-col compact cards */
  .mp-drawer-wishlist { box-shadow: 0 -6px 16px rgba(0,0,0,0.09); padding: 0.9rem 1.5rem 0.6rem; }
  .mp-drawer-wishlist__hd { font-size: 0.85rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #2d4f5c; margin-bottom: 0.65rem; }
  .mp-drawer-wishlist__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; }
  .mp-wl-card { display: flex; flex-direction: column; gap: 0.18rem; }
  .mp-wl-card__thumb { display: block; border-radius: 5px; overflow: hidden; height: 88px; flex-shrink: 0; }
  .mp-wl-card__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mp-wl-card__no-img { background: #edf1f3; width: 100%; height: 100%; }
  .mp-wl-card__name { font-size: 1rem; color: #16323f; font-weight: 600; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-decoration: none; margin-top: 0.2rem; }
  .mp-wl-card__name:hover { color: #f2872f; }
  .mp-wl-card__price { font-size: 0.9rem; color: #4a6570; }
  .mp-wl-card__add { width: 100%; background: #f2872f; color: #fff; border: none; border-radius: 5px; padding: 0.35rem 0; font-size: 0.88rem; font-weight: 700; cursor: pointer; font-family: inherit; margin-top: auto; }
  .mp-wl-card__add:hover:not(:disabled) { background: #e07928; }
  .mp-wl-card__add:disabled { opacity: 0.6; cursor: not-allowed; }
  .mp-wl-card__sold { font-size: 0.85rem; color: #9fb4bd; margin-top: auto; text-align: center; padding-top: 0.3rem; }
  .mp-drawer-wishlist__nav { display: flex; justify-content: flex-end; gap: 0.4rem; margin-top: 0.55rem; }
  .mp-drawer-wl-nav-btn { background: #16323f; color: #fff; border: none; border-radius: 6px; width: 1.8rem; height: 1.8rem; font-size: 1.1rem; cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0; font-family: inherit; }
  .mp-drawer-wl-nav-btn:hover:not(:disabled) { background: #1e4557; }
  .mp-drawer-wl-nav-btn:disabled { opacity: 0.3; cursor: default; }
  /* Base game upsell */
  .mp-cart-basegame-upsell { padding: 0.8rem 1rem; border-top: 1px solid #edf1f3; }
  .mp-cart-basegame-upsell__hd { font-size: 0.82rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: #2d4f5c; margin: 0 0 0.6rem; }
  .mp-cart-basegame { display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 0.75rem; background: #f7f3ec; border: 1px solid #e7ddcb; border-radius: 8px; margin-bottom: 0.5rem; }
  .mp-cart-basegame:last-child { margin-bottom: 0; }
  .mp-cart-basegame__img { width: 52px; height: 52px; object-fit: cover; border-radius: 4px; display: block; flex-shrink: 0; }
  .mp-cart-basegame__body { flex: 1; min-width: 0; }
  .mp-cart-basegame__label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #f2872f; margin: 0 0 2px; }
  .mp-cart-basegame__title { font-size: 13px; font-weight: 600; color: #16323f; text-decoration: none; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mp-cart-basegame__title:hover { color: #f2872f; }
  .mp-cart-basegame__price { font-size: 12px; color: #4a6570; margin: 2px 0 0; }
  .mp-cart-basegame__btn { background: #16323f; color: #fff; border: none; border-radius: 6px; padding: 0.4rem 0.75rem; font-size: 0.82rem; font-weight: 700; cursor: pointer; font-family: inherit; white-space: nowrap; flex-shrink: 0; }
  .mp-cart-basegame__btn:hover:not(:disabled) { background: #1e4557; }
  .mp-cart-basegame__btn:disabled { opacity: 0.6; cursor: not-allowed; }
  .mp-cart-basegame__sold { font-size: 0.82rem; color: #9fb4bd; white-space: nowrap; flex-shrink: 0; }
  /* Remove modal */
  .mp-remove-modal { position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.45); }
  .mp-remove-modal[hidden] { display: none; }
  .mp-remove-modal__box { background: #fff; border-radius: 14px; padding: 2.4rem 2.6rem; max-width: 42rem; width: calc(100% - 3rem); box-shadow: 0 8px 40px rgba(0,0,0,0.22); }
  .mp-remove-modal__q { font-size: 1.15rem; font-weight: 600; color: #16323f; margin: 0 0 1.6rem; line-height: 1.45; }
  .mp-remove-modal__actions { display: flex; flex-direction: column; gap: 0.55rem; }
  .mp-remove-modal__save { background: #16323f; color: #fff; border: none; border-radius: 8px; padding: 0.75rem 1rem; font-size: 0.9rem; font-weight: 700; cursor: pointer; font-family: inherit; }
  .mp-remove-modal__save:hover { background: #1e4557; }
  .mp-remove-modal__just { background: transparent; color: #9fb4bd; border: 1px solid #d0d9dc; border-radius: 8px; padding: 0.75rem 1rem; font-size: 0.9rem; cursor: pointer; font-family: inherit; }
  .mp-remove-modal__just:hover { color: #16323f; border-color: #16323f; }
</style>

<cart-drawer class="drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner gradient color-{{ settings.cart_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      {%- if cart == empty -%}
        <div class="drawer__inner-empty">
          <div class="cart-drawer__warnings center{% if settings.cart_drawer_collection != blank %} cart-drawer__warnings--has-collection{% endif %}">
            <div class="cart-drawer__empty-content">
              <h2 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h2>
              <button
                class="drawer__close"
                type="button"
                onclick="this.closest('cart-drawer').close()"
                aria-label="{{ 'accessibility.close' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
              <a href="{{ routes.all_products_collection_url }}" class="button">
                {{ 'general.continue_shopping' | t }}
              </a>

              {%- if shop.customer_accounts_enabled and customer == null -%}
                <p class="cart__login-title h3">{{ 'sections.cart.login.title' | t }}</p>
                <p class="cart__login-paragraph">
                  {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
                </p>
              {%- endif -%}
            </div>
          </div>
          {%- if settings.cart_drawer_collection != blank -%}
            <div class="cart-drawer__collection">
              {% render 'card-collection', card_collection: settings.cart_drawer_collection, columns: 1 %}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="drawer__header">
        <h2 class="drawer__heading">{{ 'sections.cart.title' | t }}</h2>
        <button
          class="drawer__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>
      <cart-drawer-items
        view-event-payload="{{ cart | standard_event_data: 'view', context: 'dialog' | escape }}"
        view-event-trigger="manual"
        {% if cart == empty %}
          class=" is-empty"
        {% endif %}
      >
        <form
          action="{{ routes.cart_url }}"
          id="CartDrawer-Form"
          class="cart__contents cart-drawer__form"
          method="post"
        >
          <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
            {%- if cart != empty -%}
              <div class="drawer__cart-items-wrapper">
                <div class="mp-cart-items">
                  {%- for item in cart.items -%}
                    {%- liquid
                      assign has_qty_rules = false
                      if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                        assign has_qty_rules = true
                      endif
                      assign has_vol_pricing = false
                      if item.variant.quantity_price_breaks.size > 0
                        assign has_vol_pricing = true
                      endif
                    -%}
                    <div
                      id="CartDrawer-Item-{{ item.index | plus: 1 }}"
                      class="mp-cart-item cart-item{% if item.parent_relationship.parent != null %} cart-item__nested-line{% endif %}"
                      role="row"
                      {% if item.parent_relationship.parent != null %}
                        aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
                      {% endif %}
                    >
                      <div class="mp-cart-item__media">
                        {% if item.image %}
                          <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                            <img
                              class="mp-cart-item__img"
                              src="{{ item.image | image_url: width: 200 }}"
                              alt="{{ item.image.alt | escape }}"
                              loading="lazy"
                              width="80"
                              height="{{ 80 | divided_by: item.image.aspect_ratio | ceil }}"
                            >
                          </a>
                        {% endif %}
                      </div>

                      <div class="mp-cart-item__body">
                        {%- if settings.show_vendor -%}
                          <p class="caption-with-letter-spacing light">{{ item.product.vendor }}</p>
                        {%- endif -%}

                        <a href="{{ item.url }}" class="mp-cart-item__name">
                          {{- item.product.title | escape -}}
                        </a>
                        {%- assign cart_disclosure_modal_id = 'CartDisclosureModal-drawer-' | append: item.key | replace: ':', '-' -%}
                        {%- render 'cart-disclosure-indicator',
                          product: item.product,
                          modal_id: cart_disclosure_modal_id
                        -%}

                        {%- if item.product.has_only_default_variant == false
                          or item.properties.size != 0
                          or item.selling_plan_allocation != null
                        -%}
                          <dl class="mp-cart-item__opts">
                            {%- if item.product.has_only_default_variant == false -%}
                              {%- for option in item.options_with_values -%}
                                <div class="product-option">
                                  <dt>{{ option.name }}:</dt>
                                  <dd>
                                    {{ option.value -}}
                                    {%- unless forloop.last %}, {% endunless %}
                                  </dd>
                                </div>
                              {%- endfor -%}
                            {%- endif -%}

                            {%- for property in item.properties -%}
                              {%- assign property_first_char = property.first | slice: 0 -%}
                              {%- if property.last != blank and property_first_char != '_' -%}
                                <div class="product-option">
                                  <dt>{{ property.first }}:</dt>
                                  <dd>
                                    {%- if property.last contains '/uploads/' -%}
                                      <a
                                        href="{{ property.last }}"
                                        class="link"
                                        target="_blank"
                                        aria-describedby="a11y-new-window-message"
                                      >
                                        {{ property.last | split: '/' | last }}
                                      </a>
                                    {%- else -%}
                                      {{ property.last }}
                                    {%- endif -%}
                                  </dd>
                                </div>
                              {%- endif -%}
                            {%- endfor -%}
                          </dl>
                          <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                        {%- endif -%}

                        <ul
                          class="discounts list-unstyled"
                          role="list"
                          aria-label="{{ 'customer.order.discount' | t }}"
                        >
                          {%- for discount in item.line_level_discount_allocations -%}
                            <li class="discounts__discount">
                              {{- 'icon-discount.svg' | inline_asset_content -}}
                              {{ discount.discount_application.title }}
                            </li>
                          {%- endfor -%}
                        </ul>

                        <div class="mp-cart-item__stepper">
                          <quantity-popover>
                            <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                              <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                                <quantity-input class="quantity cart-quantity mp-cart-quantity">
                                  <button
                                    class="quantity__button"
                                    name="minus"
                                    type="button"
                                    {% if item.instructions and item.instructions.can_update_quantity == false %}
                                      disabled
                                    {% endif %}
                                  >
                                    <span class="visually-hidden">
                                      {{-
                                        'products.product.quantity.decrease'
                                        | t: product: item.product.title
                                        | escape
                                      -}}
                                    </span>
                                    <span class="svg-wrapper">
                                      {{- 'icon-minus.svg' | inline_asset_content -}}
                                    </span>
                                  </button>
                                  <input
                                    class="quantity__input"
                                    type="number"
                                    data-quantity-variant-id="{{ item.variant.id }}"
                                    data-quantity-line-key="{{ item.key }}"
                                    name="updates[]"
                                    value="{{ item.quantity }}"
                                    {% # theme-check-disable %}
                                    data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                    min="0"
                                    data-min="{{ item.variant.quantity_rule.min }}"
                                    {% if item.variant.quantity_rule.max != null %}
                                      max="{{ item.variant.quantity_rule.max }}"
                                    {% endif %}
                                    step="{{ item.variant.quantity_rule.increment }}"
                                    {% # theme-check-enable %}
                                    aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                    id="Drawer-quantity-{{ item.index | plus: 1 }}"
                                    data-index="{{ item.index | plus: 1 }}"
                                    {% if item.instructions and item.instructions.can_update_quantity == false %}
                                      disabled
                                    {% endif %}
                                  >
                                  <button
                                    class="quantity__button"
                                    name="plus"
                                    type="button"
                                    {% if item.instructions and item.instructions.can_update_quantity == false %}
                                      disabled
                                    {% endif %}
                                  >
                                    <span class="visually-hidden">
                                      {{-
                                        'products.product.quantity.increase'
                                        | t: product: item.product.title
                                        | escape
                                      -}}
                                    </span>
                                    <span class="svg-wrapper">
                                      {{- 'icon-plus.svg' | inline_asset_content -}}
                                    </span>
                                  </button>
                                </quantity-input>
                              </div>
                            </div>
                            {%- if has_qty_rules or has_vol_pricing -%}
                              <button
                                type="button"
                                class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary"
                                aria-expanded="false"
                              >
                                <span class="svg-wrapper">
                                  {{- 'icon-info.svg' | inline_asset_content -}}
                                </span>
                                <span>
                                  {%- if has_vol_pricing -%}
                                    {{ 'products.product.volume_pricing.note' | t }}
                                  {%- elsif has_qty_rules -%}
                                    {{ 'products.product.quantity.note' | t }}
                                  {%- endif -%}
                                </span>
                              </button>
                            {%- endif -%}
                            {%- if has_vol_pricing or has_qty_rules -%}
                              <div
                                class="cart-items__info global-settings-popup quantity-popover__info"
                                tabindex="-1"
                                hidden
                              >
                                {%- if has_qty_rules == false -%}
                                  <span class="volume-pricing-label caption">
                                    {{- 'products.product.volume_pricing.title' | t -}}
                                  </span>
                                {%- endif -%}
                                <div class="quantity__rules caption">
                                  {%- if item.variant.quantity_rule.increment > 1 -%}
                                    <span class="divider">
                                      {{-
                                        'products.product.quantity.multiples_of'
                                        | t: quantity: item.variant.quantity_rule.increment
                                      -}}
                                    </span>
                                  {%- endif -%}
                                  {%- if item.variant.quantity_rule.min > 1 -%}
                                    <span class="divider">
                                      {{-
                                        'products.product.quantity.min_of'
                                        | t: quantity: item.variant.quantity_rule.min
                                      -}}
                                    </span>
                                  {%- endif -%}
                                  {%- if item.variant.quantity_rule.max != null -%}
                                    <span class="divider">
                                      {{-
                                        'products.product.quantity.max_of'
                                        | t: quantity: item.variant.quantity_rule.max
                                      -}}
                                    </span>
                                  {%- endif -%}
                                </div>
                                <button
                                  class="button-close button button--tertiary"
                                  type="button"
                                  aria-label="{{ 'accessibility.close' | t }}"
                                >
                                  <span class="svg-wrapper">
                                    {{- 'icon-close.svg' | inline_asset_content -}}
                                  </span>
                                </button>
                                {%- if item.variant.quantity_price_breaks.size > 0 -%}
                                  <volume-pricing class="parent-display">
                                    <ul class="list-unstyled">
                                      <li>
                                        <span>{{ item.variant.quantity_rule.min }}+</span>
                                        <span>{{ item.variant.price | money_with_currency }}/ea</span>
                                      </li>
                                      {%- for price_break in item.variant.quantity_price_breaks -%}
                                        <li>
                                          <span>
                                            {{- price_break.minimum_quantity -}}
                                            <span aria-hidden="true">+</span></span
                                          >
                                          <span>{{ price_break.price | money_with_currency }}/ea</span>
                                        </li>
                                      {%- endfor -%}
                                    </ul>
                                  </volume-pricing>
                                {%- endif -%}
                              </div>
                            {%- endif -%}
                            <div
                              id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}"
                              class="cart-item__error"
                              role="alert"
                            >
                              <small class="cart-item__error-text"></small>
                              <span class="svg-wrapper">
                                {{- 'icon-error.svg' | inline_asset_content -}}
                              </span>
                            </div>
                          </quantity-popover>
                        </div>
                      </div>

                      <div class="mp-cart-item__right">
                        <cart-remove-button
                          id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                          data-index="{{ item.index | plus: 1 }}"
                          data-product-id="{{ item.product_id }}"
                          data-product-handle="{{ item.product.handle | escape }}"
                          data-product-title="{{ item.product.title | escape }}"
                        >
                          <button
                            type="button"
                            class="mp-cart-remove-x cart-remove-button{% if item.instructions and item.instructions.can_remove == false %} hidden{% endif %}"
                            aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                            data-variant-id="{{ item.variant.id }}"
                          >&times;</button>
                        </cart-remove-button>
                        <div class="mp-cart-item__price">
                          {%- render 'loading-spinner' -%}
                          {%- if item.original_price != item.final_price -%}
                            <div class="cart-item__discounted-prices">
                              <span class="visually-hidden">
                                {{ 'products.product.price.regular_price' | t }}
                              </span>
                              <s class="cart-item__old-price price price--end">
                                {{ item.original_price | money }}
                              </s>
                              <span class="visually-hidden">
                                {{ 'products.product.price.sale_price' | t }}
                              </span>
                              <span class="price price--end">
                                {{ item.final_price | money }}
                              </span>
                            </div>
                          {%- else -%}
                            <span class="price price--end">
                              {{ item.original_price | money }}
                            </span>
                          {%- endif -%}
                          {%- if item.variant.available and item.unit_price_measurement -%}
                            {% render 'unit-price',
                              price: item.unit_price,
                              measurement: item.unit_price_measurement
                            %}
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
            <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
            <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
              {{ 'accessibility.loading' | t }}
            </p>
          </div>
          <div id="CartDrawer-CartErrors" role="alert"></div>
        </form>
      </cart-drawer-items>
      {%- if cart != empty -%}
        {%- assign mp_cart_pids = cart.items | map: 'product_id' | join: ',' -%}
        {%- capture mp_basegame_upsell -%}
          {%- assign cart_product_ids = cart.items | map: 'product_id' -%}
          {%- assign shown_basegame_ids = '' -%}
          {%- for item in cart.items -%}
            {%- if item.product.type == 'Board Game Expansion' or item.product.type == 'Board Game Insert' or item.product.type == 'Board Game Accessory' -%}
              {%- assign insert_for_games = item.product.metafields.custom.insert_for_game.value -%}
              {%- if insert_for_games != blank -%}
                {%- for base_game in insert_for_games -%}
                  {%- assign base_id_str = base_game.id | append: '' -%}
                  {%- unless cart_product_ids contains base_game.id or shown_basegame_ids contains base_id_str -%}
                    {%- assign shown_basegame_ids = shown_basegame_ids | append: base_id_str | append: ',' -%}
                    {%- assign base_variant = base_game.first_available_variant -%}
                    <div class="mp-cart-basegame">
                      {%- if base_game.featured_image -%}
                        <a href="{{ base_game.url }}" tabindex="-1" aria-hidden="true">
                          <img class="mp-cart-basegame__img" src="{{ base_game.featured_image | image_url: width: 80 }}" alt="{{ base_game.title | escape }}" loading="lazy">
                        </a>
                      {%- endif -%}
                      <div class="mp-cart-basegame__body">
                        <p class="mp-cart-basegame__label">Base game</p>
                        <a class="mp-cart-basegame__title" href="{{ base_game.url }}">{{ base_game.title }}</a>
                        <p class="mp-cart-basegame__price">{{ base_game.price | money }}</p>
                      </div>
                      {%- if base_game.available and base_variant != blank -%}
                        <form class="mp-cart-basegame__form" action="/cart/add" method="post">
                          <input type="hidden" name="id" value="{{ base_variant.id }}">
                          <input type="hidden" name="quantity" value="1">
                          <button type="submit" class="mp-cart-basegame__btn">Add</button>
                        </form>
                      {%- else -%}
                        <span class="mp-cart-basegame__sold">Sold out</span>
                      {%- endif -%}
                    </div>
                  {%- endunless -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if mp_basegame_upsell != blank -%}
          <div class="mp-cart-basegame-upsell">
            <p class="mp-cart-basegame-upsell__hd">Don't forget the base game</p>
            {{ mp_basegame_upsell }}
          </div>
        {%- endif -%}
        <div class="mp-drawer-wishlist" data-mp-cart-pids="{{ mp_cart_pids }}" hidden>
          <div class="mp-drawer-wishlist__hd">From your wishlist</div>
          <div class="mp-drawer-wishlist__grid"></div>
          <div class="mp-drawer-wishlist__nav" hidden>
            <button type="button" class="mp-drawer-wl-nav-btn" data-mp-wl-prev aria-label="Previous" disabled>&#8249;</button>
            <button type="button" class="mp-drawer-wl-nav-btn" data-mp-wl-next aria-label="Next">&#8250;</button>
          </div>
        </div>
      {%- endif -%}

      <div class="drawer__footer">
        {%- if settings.show_cart_note -%}
          <details id="Details-CartDrawer">
            <summary>
              <span class="summary__title">
                {{ 'sections.cart.note' | t }}
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </summary>
            <cart-note class="cart__note field">
              <label class="visually-hidden" for="CartDrawer-Note">{{ 'sections.cart.note' | t }}</label>
              <textarea
                id="CartDrawer-Note"
                class="text-area text-area--resize-vertical field__input"
                name="note"
                placeholder="{{ 'sections.cart.note' | t }}"
              >{{ cart.note }}</textarea>
            </cart-note>
          </details>
        {%- endif -%}

        <!-- Start blocks -->
        <!-- Subtotals -->

        <div class="cart-drawer__footer" {{ block.shopify_attributes }}>
          <div>
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                {%- for discount in cart.cart_level_discount_applications -%}
                  <li class="discounts__discount discounts__discount--end">
                    {{- 'icon-discount.svg' | inline_asset_content -}}
                    {{ discount.title | escape }}
                    (-{{ discount.total_allocated_amount | money }})
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>

          <div class="totals" role="status">
            <h2 class="totals__total">{{ 'sections.cart.estimated_total' | t }}</h2>
            <p class="totals__total-value">{{ cart.total_price | money_with_currency }}</p>
          </div>

          <small class="tax-note caption-large rte">
            {%- if cart.duties_included and cart.taxes_included -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.duties_and_taxes_included_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- elsif cart.duties_included == false and cart.taxes_included -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.taxes_included_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- elsif cart.duties_included and cart.taxes_included == false -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- elsif cart.duties_included == false and cart.taxes_included == false -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{
                  'sections.cart.taxes_at_checkout_shipping_at_checkout_with_policy_html'
                  | t: link: shop.shipping_policy.url
                }}
              {%- endif -%}
            {%- endif -%}
          </small>
        </div>

        <!-- CTAs -->

        <div class="cart__ctas" {{ block.shopify_attributes }}>
          <a
            href="{{ routes.cart_url }}"
            class="cart__checkout-button button{% if cart == empty %} disabled{% endif %}"
          >
            {{ 'sections.cart.checkout' | t }}
          </a>
        </div>
      </div>
    </div>
  </div>
</cart-drawer>

<div id="mp-remove-modal" class="mp-remove-modal" hidden>
  <div class="mp-remove-modal__box">
    <p class="mp-remove-modal__q">Save this item to your wishlist before removing?</p>
    <div class="mp-remove-modal__actions">
      <button type="button" class="mp-remove-modal__save">Save &amp; remove</button>
      <button type="button" class="mp-remove-modal__just">Just remove</button>
    </div>
  </div>
</div>

<script>
(function () {
  'use strict';

  function esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function fmtPrice(pence) {
    try { return new Intl.NumberFormat('en-GB',{style:'currency',currency:'GBP'}).format(pence/100); }
    catch(_) { return '£'+(pence/100).toFixed(2); }
  }
  function lcHandle(id) {
    try { var c=JSON.parse(localStorage.getItem('mp_wishlist_handles')); return c&&c[id]&&c[id].handle; }
    catch(_) { return null; }
  }

  /* ── Remove-button → modal ── */
  var _modal = document.getElementById('mp-remove-modal');
  var _pendingRemove = null;
  var _busy = new WeakSet();

  if (_modal) {
    _modal.querySelector('.mp-remove-modal__save').addEventListener('click', function () {
      if (_pendingRemove) {
        var el = _pendingRemove;
        if (window.MPWishlist && typeof MPWishlist.add === 'function') {
          MPWishlist.add(el.dataset.productId, 'Wishlist', {
            handle: el.dataset.productHandle,
            title:  el.dataset.productTitle
          });
        }
        _doRemove(el);
      }
      _closeModal();
    });
    _modal.querySelector('.mp-remove-modal__just').addEventListener('click', function () {
      if (_pendingRemove) { _doRemove(_pendingRemove); }
      _closeModal();
    });
    _modal.addEventListener('click', function (e) { if (e.target === _modal) { _closeModal(); } });
  }

  function _closeModal() { if (_modal) { _modal.hidden = true; } _pendingRemove = null; }

  document.addEventListener('click', function (e) {
    var removeEl = e.target.closest('cart-remove-button');
    if (!removeEl || !removeEl.closest('cart-drawer') || _busy.has(removeEl)) { return; }
    var cfg = window.mpWishlist;
    if (!cfg || !cfg.loggedIn || !window.MPWishlist || !_modal) { return; }
    e.stopImmediatePropagation();
    e.preventDefault();
    _pendingRemove = removeEl;
    _modal.hidden = false;
  }, true);

  function _doRemove(el) {
    _busy.add(el);
    var lineIndex = parseInt(el.getAttribute('data-index'), 10);
    if (!lineIndex) { return; }
    var cartItemEl = el.closest('.mp-cart-item');

    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ line: lineIndex, quantity: 0 })
    })
    .then(function (r) { return r.ok ? r.json() : Promise.reject(r); })
    .then(function (cart) {
      // Animate the item out
      if (cartItemEl) {
        cartItemEl.style.transition = 'opacity 0.2s, max-height 0.3s 0.05s, padding 0.3s 0.05s';
        cartItemEl.style.overflow = 'hidden';
        cartItemEl.style.maxHeight = cartItemEl.offsetHeight + 'px';
        requestAnimationFrame(function () {
          cartItemEl.style.opacity = '0';
          cartItemEl.style.maxHeight = '0';
          cartItemEl.style.paddingTop = '0';
          cartItemEl.style.paddingBottom = '0';
        });
        setTimeout(function () { cartItemEl.remove(); }, 350);
      }
      // Update header cart summary
      document.querySelectorAll('[data-cart-summary]').forEach(function (s) {
        s.innerHTML = cart.item_count + ' · ' + fmtPrice(cart.total_price);
      });
      // Update totals in the drawer footer
      var totalEl = document.querySelector('.totals__total-value');
      if (totalEl) { totalEl.textContent = fmtPrice(cart.total_price); }
      // Re-index remaining remove buttons so subsequent removes use the correct line
      setTimeout(function () {
        document.querySelectorAll('cart-remove-button[data-index]').forEach(function (btn, i) {
          btn.setAttribute('data-index', i + 1);
        });
        _busy.delete(el);
      }, 360);
      // Cart now empty — reload to show the empty drawer state
      if (cart.item_count === 0) { setTimeout(function () { window.location.reload(); }, 420); }
    })
    .catch(function () { window.location.reload(); });
  }

  /* ── Wishlist 2-col cards with pagination ── */
  var _wlCache = null;
  var _wlProdCache = {};
  var _wlItems = [];
  var _wlPage  = 0;
  var _wlGen   = 0;

  function _fetchProd(handle) {
    if (_wlProdCache[handle]) { return Promise.resolve(_wlProdCache[handle]); }
    return fetch('/products/'+handle+'.js', { headers:{Accept:'application/json'} })
      .then(function(r){ return r.ok ? r.json() : null; })
      .then(function(p){ if(p){ _wlProdCache[handle]=p; } return p; })
      .catch(function(){ return null; });
  }

  function _renderWishlist() {
    var section = document.querySelector('.mp-drawer-wishlist');
    if (!section) { return; }
    var cfg = window.mpWishlist;
    if (!cfg || !cfg.loggedIn) { return; }

    var cartPids = (section.dataset.mpCartPids||'').split(',').filter(Boolean);
    var grid = section.querySelector('.mp-drawer-wishlist__grid');
    var nav  = section.querySelector('.mp-drawer-wishlist__nav');
    if (!grid) { return; }

    section.hidden = true;
    grid.innerHTML = '';
    _wlPage  = 0;
    _wlItems = [];
    var thisGen = ++_wlGen;

    function _afterData(data) {
      var seen = {}, handles = [];
      (data.groups||[]).forEach(function(g){
        (g.items||[]).forEach(function(it){
          var id = String(it.product_id||it.id||'');
          if (!id || seen[id] || cartPids.indexOf(id)!==-1) { return; }
          var h = it.handle || lcHandle(id);
          if (!h) { return; }
          seen[id] = true;
          handles.push(h);
        });
      });
      if (!handles.length) { return; }
      Promise.all(handles.slice(0,8).map(_fetchProd)).then(function(products){
        if (thisGen !== _wlGen) { return; }
        _wlItems = products.filter(Boolean);
        if (!_wlItems.length) { return; }
        section.hidden = false;
        _paintGrid();
      });
    }

    if (_wlCache) { _afterData(_wlCache); return; }
    fetch(cfg.endpoint, { headers:{Accept:'application/json'}, credentials:'same-origin' })
      .then(function(r){ return r.ok ? r.json() : null; })
      .then(function(d){
        if (thisGen!==_wlGen || !d || d.ok===false) { return; }
        _wlCache = d;
        _afterData(d);
      })
      .catch(function(){});
  }

  function _paintGrid() {
    var wlSection = document.querySelector('.mp-drawer-wishlist');
    if (!wlSection) { return; }
    var grid = wlSection.querySelector('.mp-drawer-wishlist__grid');
    var nav  = wlSection.querySelector('.mp-drawer-wishlist__nav');
    if (!grid) { return; }
    grid.innerHTML = '';
    var start = _wlPage * 4;
    _wlItems.slice(start, start+4).forEach(function(p){ grid.appendChild(_wlCard(p)); });
    if (!nav) { return; }
    if (_wlItems.length > 4) {
      nav.hidden = false;
      var prevBtn = nav.querySelector('[data-mp-wl-prev]');
      var nextBtn = nav.querySelector('[data-mp-wl-next]');
      if (prevBtn) { prevBtn.disabled = (_wlPage === 0); }
      if (nextBtn) { nextBtn.disabled = ((_wlPage+1)*4 >= _wlItems.length); }
    } else {
      nav.hidden = true;
    }
  }

  function _wlCard(product) {
    var variantId = product.variants && product.variants[0] && product.variants[0].id;
    var imgTag = product.featured_image
      ? '<img src="'+esc(product.featured_image)+'&width=160" alt="" loading="lazy" class="mp-wl-card__img">'
      : '<div class="mp-wl-card__img mp-wl-card__no-img"></div>';
    var btn = product.available && variantId
      ? '<button type="button" class="mp-wl-card__add" data-v="'+variantId+'">Add to basket</button>'
      : '<span class="mp-wl-card__sold">Sold out</span>';
    var card = document.createElement('div');
    card.className = 'mp-wl-card';
    card.innerHTML =
      '<a href="'+esc(product.url)+'" class="mp-wl-card__thumb" tabindex="-1">'+imgTag+'</a>'+
      '<a href="'+esc(product.url)+'" class="mp-wl-card__name">'+esc(product.title)+'</a>'+
      '<div class="mp-wl-card__price">'+fmtPrice(product.price)+'</div>'+
      btn;
    var addBtn = card.querySelector('.mp-wl-card__add');
    if (addBtn) {
      addBtn.addEventListener('click', function(){
        addBtn.disabled = true;
        addBtn.textContent = 'Adding…';
        fetch('/cart/add.js', {
          method:'POST',
          headers:{'Content-Type':'application/json',Accept:'application/json'},
          credentials:'same-origin',
          body:JSON.stringify({items:[{id:parseInt(addBtn.dataset.v,10),quantity:1}]})
        })
          .then(function(r){ return r.ok ? r.json() : Promise.reject(); })
          .then(function(){ window.location.reload(); })
          .catch(function(){ addBtn.disabled=false; addBtn.textContent='Add to basket'; });
      });
    }
    return card;
  }

  document.addEventListener('click', function(e) {
    var nextEl = e.target.closest('[data-mp-wl-next]');
    var prevEl = e.target.closest('[data-mp-wl-prev]');
    if (nextEl && !nextEl.disabled) {
      if ((_wlPage+1)*4 < _wlItems.length) { _wlPage++; _paintGrid(); }
    } else if (prevEl && !prevEl.disabled) {
      if (_wlPage > 0) { _wlPage--; _paintGrid(); }
    }
  });

  function _watchDrawer() {
    var el = document.querySelector('#CartDrawer');
    if (!el) { return; }
    new MutationObserver(function(){ setTimeout(_renderWishlist, 60); }).observe(el, {childList:true});
  }

  if (document.readyState==='loading') {
    document.addEventListener('DOMContentLoaded', function(){ _renderWishlist(); _watchDrawer(); });
  } else {
    _renderWishlist();
    _watchDrawer();
  }

  /* ── Base game upsell add-to-cart ── */
  document.addEventListener('submit', function (e) {
    var form = e.target.closest('.mp-cart-basegame__form');
    if (!form) { return; }
    e.preventDefault();
    var btn = form.querySelector('.mp-cart-basegame__btn');
    var variantInput = form.querySelector('[name="id"]');
    if (!btn || !variantInput) { return; }
    btn.disabled = true;
    btn.textContent = '…';
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ items: [{ id: parseInt(variantInput.value, 10), quantity: 1 }] })
    })
      .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
      .then(function () { window.location.reload(); })
      .catch(function () { btn.disabled = false; btn.textContent = 'Add'; });
  });
})();
</script>
