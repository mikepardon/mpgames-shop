{%- comment -%}
  Wishlist heart toggle button.
  Usage: {% render 'mp-wishlist-button', product: product, class: 'cl__wish' %}
  - product : the product to save (required)
  - class   : extra positioning class(es) for the host context (e.g. cl__wish,
              mp-card__wish, se__wish, pdp__wish, or mp-wish--float where the
              section provides no placeholder styling).
  Fill state is hydrated client-side on load by assets/mp-wishlist.js from the
  wishlist read endpoint, so the server renders it unfilled by default.
{%- endcomment -%}
<button
  type="button"
  class="mp-wish {{ class }}"
  data-wishlist-btn
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-product-title="{{ product.title | escape }}"
  aria-pressed="false"
  aria-label="Save {{ product.title | escape }} to a wishlist"
  title="Add to wishlist"
>
  <svg class="mp-wish__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20.7l-1.45-1.32C5.4 14.76 2 11.67 2 7.95 2 5.17 4.2 3 6.95 3c1.54 0 3.03.72 4.05 1.86C12.02 3.72 13.5 3 15.05 3 17.8 3 20 5.17 20 7.95c0 3.72-3.4 6.81-8.55 11.44L12 20.7z"/></svg>
  {%- if label != blank -%}<span class="mp-wish__label" data-wishlist-label>{{ label }}</span>{%- endif -%}
</button>
