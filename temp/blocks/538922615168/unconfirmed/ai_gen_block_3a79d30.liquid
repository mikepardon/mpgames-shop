{% doc %}
  @prompt
    Create a new Shopify theme block called “Notify Me” specifically for product pages, intended to be added to the product template’s product information section, not the homepage. Show it only when the current product has no available inventory. When a customer is logged in, let them submit a back-in-stock notification request and send a JSON POST to https://partners.mpgames.io/webhooks/shopify/stock-notifications containing type “back_in_stock”, the logged-in customer’s email, display name, phone, Shopify customer ID, and the current product ID. When the customer is not logged in, explain that they must sign in or create an account to receive the notification and provide links for both actions. Include clear success and error states and prevent duplicate submissions while the request is being sent. Do not embed any private webhook token in storefront code. Provide a secure authentication configuration point for a server-side proxy or browser-safe endpoint. The block must be designed for product-page placement only and must not be enabled on the homepage.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% if template.name == 'product' and product and product.available == false %}
  {% style %}
    .ai-notify-me-{{ ai_gen_id }} {
      display: block;
      width: {{ block.settings.desktop_width_percent }}%;
      max-width: 100%;
      padding: 20px;
      border: 1px solid rgba(18, 18, 18, 0.18);
      border-radius: {{ block.settings.border_radius }}px;
      background: #f3f3f3;
      color: #121212;
    }

    .ai-notify-me-{{ ai_gen_id }}__title {
      margin: 0 0 8px;
      font-size: 1.25rem;
      line-height: 1.3;
    }

    .ai-notify-me-{{ ai_gen_id }}__message,
    .ai-notify-me-{{ ai_gen_id }}__status {
      margin: 0 0 16px;
      line-height: 1.5;
    }

    .ai-notify-me-{{ ai_gen_id }}__links {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .ai-notify-me-{{ ai_gen_id }}__link,
    .ai-notify-me-{{ ai_gen_id }}__submit {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 10px 18px;
      border-radius: {{ block.settings.button_radius }}px;
      font: inherit;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
    }

    .ai-notify-me-{{ ai_gen_id }}__link--primary,
    .ai-notify-me-{{ ai_gen_id }}__submit {
      border: 1px solid #121212;
      background: #121212;
      color: #ffffff;
    }

    .ai-notify-me-{{ ai_gen_id }}__link--secondary {
      border: 1px solid #121212;
      background: #ffffff;
      color: #121212;
    }

    .ai-notify-me-{{ ai_gen_id }}__submit:disabled {
      cursor: wait;
      opacity: 0.6;
    }

    .ai-notify-me-{{ ai_gen_id }}__status[hidden] {
      display: none;
    }

    .ai-notify-me-{{ ai_gen_id }}__status--success {
      color: #146c2e;
    }

    .ai-notify-me-{{ ai_gen_id }}__status--error {
      color: #a21919;
    }
  {% endstyle %}

  <notify-me-{{ ai_gen_id }}
    class="ai-notify-me-{{ ai_gen_id }}"
    data-endpoint="{{ block.settings.endpoint | escape }}"
    data-product-id="{{ product.id }}"
    {{ block.shopify_attributes }}
  >
    <h2 class="ai-notify-me-{{ ai_gen_id }}__title">{{ block.settings.heading }}</h2>

    {% if customer %}
      <p class="ai-notify-me-{{ ai_gen_id }}__message">{{ block.settings.logged_in_message }}</p>
      <button type="button" class="ai-notify-me-{{ ai_gen_id }}__submit">{{ block.settings.button_label }}</button>
      <p class="ai-notify-me-{{ ai_gen_id }}__status" role="status" aria-live="polite" hidden></p>
    {% else %}
      <p class="ai-notify-me-{{ ai_gen_id }}__message">{{ block.settings.logged_out_message }}</p>
      <div class="ai-notify-me-{{ ai_gen_id }}__links">
        <a class="ai-notify-me-{{ ai_gen_id }}__link ai-notify-me-{{ ai_gen_id }}__link--primary" href="{{ routes.account_login_url }}">{{ block.settings.sign_in_label }}</a>
        <a class="ai-notify-me-{{ ai_gen_id }}__link ai-notify-me-{{ ai_gen_id }}__link--secondary" href="{{ routes.account_register_url }}">{{ block.settings.create_account_label }}</a>
      </div>
    {% endif %}
  </notify-me-{{ ai_gen_id }}>

  {% if customer %}
    <script>
      (function() {
        class NotifyMe{{ ai_gen_id }} extends HTMLElement {
          connectedCallback() {
            this.button = this.querySelector('.ai-notify-me-{{ ai_gen_id }}__submit');
            this.status = this.querySelector('.ai-notify-me-{{ ai_gen_id }}__status');
            if (this.button) this.button.addEventListener('click', () => this.submitRequest());
          }

          async submitRequest() {
            if (this.button.disabled) return;
            this.button.disabled = true;
            this.status.hidden = true;
            try {
              const response = await fetch(this.dataset.endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({
                  type: 'back_in_stock',
                  email: {{ customer.email | json }},
                  display_name: {{ customer.name | json }},
                  phone: {{ customer.phone | default: customer.default_address.phone | json }},
                  customer_id: {{ customer.id | json }},
                  product_id: this.dataset.productId
                })
              });
              if (!response.ok) throw new Error('Request failed');
              this.status.textContent = {{ block.settings.success_message | json }};
              this.status.className = 'ai-notify-me-{{ ai_gen_id }}__status ai-notify-me-{{ ai_gen_id }}__status--success';
            } catch (error) {
              this.status.textContent = {{ block.settings.error_message | json }};
              this.status.className = 'ai-notify-me-{{ ai_gen_id }}__status ai-notify-me-{{ ai_gen_id }}__status--error';
              this.button.disabled = false;
            }
            this.status.hidden = false;
          }
        }
        customElements.define('notify-me-{{ ai_gen_id }}', NotifyMe{{ ai_gen_id }});
      })();
    </script>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Notify Me",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Notify me when available" },
    { "type": "textarea", "id": "logged_in_message", "label": "Signed-in message", "default": "Get an email when this product is back in stock." },
    { "type": "textarea", "id": "logged_out_message", "label": "Signed-out message", "default": "Sign in or create an account to receive a back-in-stock notification." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Notify me" },
    { "type": "text", "id": "sign_in_label", "label": "Sign-in label", "default": "Sign in" },
    { "type": "text", "id": "create_account_label", "label": "Create-account label", "default": "Create an account" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks. We’ll notify you when this product is back in stock." },
    { "type": "text", "id": "error_message", "label": "Error message", "default": "We couldn’t save your request. Please try again." },
    { "type": "header", "content": "Connection" },
    { "type": "text", "id": "endpoint", "label": "Notification endpoint", "default": "https://partners.mpgames.io/webhooks/shopify/stock-notifications" },
    { "type": "paragraph", "content": "Use this endpoint as a browser-safe endpoint or point it to your server-side proxy. Keep private authentication tokens on the server; none are included in this storefront block." },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "border_radius", "label": "Border radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Notify Me" }],
  "tag": null,
  "class": "notify-me-block"
}
{% endschema %}