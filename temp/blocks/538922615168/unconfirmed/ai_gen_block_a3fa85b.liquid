{% doc %}
  @prompt
    Create a new Shopify theme block for product pages called “Notify Me” that appears when the product has no available inventory. When a customer is logged in, let them submit a back-in-stock notification request and send a JSON POST to https://partners.mpgames.io/webhooks/shopify/stock-notifications with type “back_in_stock”, the logged-in customer’s email, display name, phone, Shopify customer ID, and the current Shopify product ID. When the customer is not logged in, explain that they must sign in or create an account to receive the notification and provide links for both actions. Include clear success and error states, prevent duplicate submissions while the request is being sent, and make the block usable on product pages. Do not embed any private webhook token in storefront code; provide a clearly marked secure authentication placeholder or configuration point for a server-side proxy, and ensure the request can be configured for the endpoint’s required authentication without exposing a secret to visitors.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-notify-me-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 20px;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-notify-me-{{ ai_gen_id }}__title {
    margin: 0 0 8px;
    font-size: 20px;
    line-height: 1.3;
  }

  .ai-notify-me-{{ ai_gen_id }}__message {
    margin: 0 0 16px;
    line-height: 1.5;
  }

  .ai-notify-me-{{ ai_gen_id }}__form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-notify-me-{{ ai_gen_id }}__button,
  .ai-notify-me-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 18px;
    border-radius: {{ block.settings.button_radius }}px;
    font: inherit;
    font-weight: 600;
  }

  .ai-notify-me-{{ ai_gen_id }}__button {
    color: {{ block.settings.button_text_color }};
    background: {{ block.settings.button_color }};
    border: 1px solid {{ block.settings.button_color }};
    cursor: pointer;
  }

  .ai-notify-me-{{ ai_gen_id }}__button:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .ai-notify-me-{{ ai_gen_id }}__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .ai-notify-me-{{ ai_gen_id }}__link {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-notify-me-{{ ai_gen_id }}__status {
    margin: 4px 0 0;
    line-height: 1.4;
  }

  .ai-notify-me-{{ ai_gen_id }}__status[hidden] {
    display: none;
  }
{% endstyle %}

{% if product and product.available == false %}
  <back-in-stock-notify-{{ ai_gen_id }}
    class="ai-notify-me-{{ ai_gen_id }}"
    data-endpoint="{{ block.settings.endpoint | escape }}"
    data-product-id="{{ product.id }}"
    data-product-title="{{ product.title | escape }}"
    {{ block.shopify_attributes }}
  >
    <h2 class="ai-notify-me-{{ ai_gen_id }}__title">{{ block.settings.heading }}</h2>

    {% if customer %}
      <p class="ai-notify-me-{{ ai_gen_id }}__message">{{ block.settings.logged_in_message }}</p>
      <form class="ai-notify-me-{{ ai_gen_id }}__form" novalidate>
        <button class="ai-notify-me-{{ ai_gen_id }}__button" type="submit">{{ block.settings.button_label }}</button>
        <p class="ai-notify-me-{{ ai_gen_id }}__status" role="status" aria-live="polite" hidden></p>
      </form>
    {% else %}
      <p class="ai-notify-me-{{ ai_gen_id }}__message">{{ block.settings.logged_out_message }}</p>
      <div class="ai-notify-me-{{ ai_gen_id }}__links">
        <a class="ai-notify-me-{{ ai_gen_id }}__link" href="{{ routes.account_login_url }}">{{ block.settings.sign_in_label }}</a>
        <a class="ai-notify-me-{{ ai_gen_id }}__link" href="{{ routes.account_register_url }}">{{ block.settings.create_account_label }}</a>
      </div>
    {% endif %}
  </back-in-stock-notify-{{ ai_gen_id }}>

  {% if customer %}
    <script type="application/json" data-customer-data-{{ ai_gen_id }}>
      {{ customer | json }}
    </script>
  {% endif %}

  <script>
    (function() {
      class BackInStockNotify{{ ai_gen_id }} extends HTMLElement {
        connectedCallback() {
          this.form = this.querySelector('form');
          if (!this.form) return;
          this.button = this.form.querySelector('button');
          this.status = this.form.querySelector('[role="status"]');
          this.form.addEventListener('submit', (event) => this.submitRequest(event));
        }

        async submitRequest(event) {
          event.preventDefault();
          if (this.button.disabled) return;
          this.button.disabled = true;
          this.status.hidden = false;
          this.status.textContent = '{{ block.settings.sending_message | escape }}';

          const customerData = this.querySelector('[data-customer-data-{{ ai_gen_id }}]');
          const customer = customerData ? JSON.parse(customerData.textContent) : {};
          const payload = {
            type: 'back_in_stock',
            email: customer.email || '',
            display_name: customer.name || '',
            phone: customer.phone || '',
            shopify_customer_id: customer.id || '',
            shopify_product_id: this.dataset.productId
          };

          try {
            const response = await fetch(this.dataset.endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              credentials: 'omit',
              body: JSON.stringify(payload)
            });
            if (!response.ok) throw new Error('Request failed');
            this.status.textContent = '{{ block.settings.success_message | escape }}';
            this.button.textContent = '{{ block.settings.success_button_label | escape }}';
          } catch (error) {
            this.status.textContent = '{{ block.settings.error_message | escape }}';
            this.button.disabled = false;
          }
        }
      }

      if (!customElements.get('back-in-stock-notify-{{ ai_gen_id }}')) {
        customElements.define('back-in-stock-notify-{{ ai_gen_id }}', BackInStockNotify{{ ai_gen_id }});
      }
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Notify Me",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Notify me when available"
    },
    {
      "type": "textarea",
      "id": "logged_in_message",
      "label": "Signed-in message",
      "default": "Get an email when this product is back in stock."
    },
    {
      "type": "textarea",
      "id": "logged_out_message",
      "label": "Signed-out message",
      "default": "Sign in or create an account to receive a back-in-stock notification."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Notify me"
    },
    {
      "type": "text",
      "id": "sign_in_label",
      "label": "Sign-in label",
      "default": "Sign in"
    },
    {
      "type": "text",
      "id": "create_account_label",
      "label": "Account label",
      "default": "Create an account"
    },
    {
      "type": "text",
      "id": "sending_message",
      "label": "Sending message",
      "default": "Sending your request…"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks. We’ll email you when it’s back in stock."
    },
    {
      "type": "text",
      "id": "success_button_label",
      "label": "Submitted label",
      "default": "Request submitted"
    },
    {
      "type": "text",
      "id": "error_message",
      "label": "Error message",
      "default": "We couldn’t submit your request. Please try again."
    },
    {
      "type": "header",
      "content": "Secure delivery"
    },
    {
      "type": "paragraph",
      "content": "Secure authentication placeholder: use a server-side proxy or Shopify app endpoint to add the webhook authentication secret. Never place a private token in this block or storefront JavaScript."
    },
    {
      "type": "url",
      "id": "endpoint",
      "label": "Notification endpoint"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F3F3F3"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#B7B7B7"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Button radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Notify Me"
    }
  ],
  "tag": null,
  "class": "notify-me-block"
}
{% endschema %}